<script>
"use strict";
const ACTIVE=["backlog","todo","working","done"], ALL=ACTIVE.concat(["archived","trash"]);
let showArchived=false, tasks=null;
const esc=s=>String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
async function load(){try{const r=await fetch("/api/board");tasks=await r.json();document.getElementById("status").textContent="更新 "+new Date().toLocaleTimeString();render();}catch(e){document.getElementById("status").textContent="连接失败";}}
function meta(c){const p=[];if(c.type)p.push("["+esc(c.type)+"]");if(c.time)p.push(esc(c.time));const m=[];if(c.review)m.push("审 "+esc(c.review));if(c.large)m.push("large");if(c.group)m.push("组 "+esc(c.group));if(c.session)m.push("会话 "+esc(c.session));if(m.length)p.push(m.join(" "));return p.join(" ");}
function render(){const kw=document.getElementById("kw").value.trim().toLowerCase();
const states=showArchived?ALL:ACTIVE;
document.getElementById("board").innerHTML=states.map(s=>{const rows=(tasks.states[s]||[]).filter(c=>!kw||(c.id+" "+c.title+" "+c.type).toLowerCase().includes(kw));
const cards=rows.map(c=>'<div class="card" data-id="'+esc(c.id)+'"><div class="cid">'+esc(c.id)+'</div><div class="ct">'+esc(c.title)+'</div>'+(meta(c)?'<div class="cm">'+meta(c)+'</div>':"")+'</div>').join("");
return '<section class="col '+s+'"><h2>'+s+' <span class="n">'+rows.length+'</span></h2>'+(cards||'<p class="empty">空</p>')+'</section>';}).join("");
document.querySelectorAll(".card").forEach(el=>el.onclick=()=>openTask(el.dataset.id));}
async function openTask(id){try{const r=await fetch("/api/tasks/"+encodeURIComponent(id));const t=await r.json();
document.getElementById("dlg-title").textContent=t.title;document.getElementById("dlg-id").textContent=id;
document.getElementById("dlg-body").innerHTML=md(t.text);document.getElementById("dlg").style.display="block";}catch(e){}}
function closeDlg(){document.getElementById("dlg").style.display="none";}
function md(s){return esc(s).split(/\\n/).map(line=>{
if(/^##\\s/.test(line))return '<h4>'+line.slice(3)+'</h4>';
if(/^#\\s/.test(line))return '<h3>'+line.slice(2)+'</h3>';
if(/^- \\[x\\]\\s/i.test(line))return '<div class="li done">☑ '+line.slice(6)+'</div>';
if(/^- \\[ \\]\\s/.test(line))return '<div class="li">☐ '+line.slice(6)+'</div>';
if(/^-\\s/.test(line))return '<div class="li">• '+line.slice(2)+'</div>';
return line===""?"":'<div>'+line+'</div>';}).join("");}
function sse(){const es=new EventSource("/api/events");es.addEventListener("board",()=>load());es.onerror=()=>{es.close();setTimeout(sse,5000);};}
document.getElementById("toggle").onclick=()=>{showArchived=!showArchived;document.getElementById("toggle").classList.toggle("on",showArchived);render();};
document.getElementById("kw").oninput=render;
document.getElementById("dlg").onclick=e=>{if(e.target.id==="dlg")closeDlg();};
load();sse();setInterval(load,30000);
</script></body></html>"""

    sse_last = {"fp": None}

    def fingerprint() -> str:
        return json.dumps(board_json(), ensure_ascii=False, sort_keys=True)

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, fmt, *a):
            pass

        def _send(self, code, body, ctype):
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            path = self.path.split("?")[0]
            if path == "/api/board":
                data = json.dumps(board_json(), ensure_ascii=False).encode("utf-8")
                return self._send(200, data, "application/json; charset=utf-8")
            if path.startswith("/api/tasks/"):
                tid = unquote(path[len("/api/tasks/"):])
                try:
                    data = json.dumps(task_json(tid), ensure_ascii=False).encode("utf-8")
                except KanbanError:
                    return self._send(404, b'{"error":"not found"}', "application/json")
                return self._send(200, data, "application/json; charset=utf-8")
            if path.startswith("/api/card/"):
                tid = unquote(path[len("/api/card/"):])
                try:
                    body = read_any_text(spec_path(find_card(board_root(), tid)[1]))
                except KanbanError:
                    return self._send(404, b"not found", "text/plain")
                return self._send(200, body.encode("utf-8"), "text/plain; charset=utf-8")
            if path == "/api/events":
                return self._stream_events()
            if path == "/":
                page = board_page.replace("__BOARD_PATH__", html.escape(board_root().as_posix()))
                return self._send(200, page.encode("utf-8"), "text/html; charset=utf-8")
            self._send(404, b"not found", "text/plain")

        def _stream_events(self):
            self.send_response(200)
            self.send_header("Content-Type", "text/event-stream; charset=utf-8")
            self.send_header("Cache-Control", "no-cache")
            self.send_header("Connection", "keep-alive")
            self.end_headers()
            try:
                counter = 0
                while True:
                    fp = fingerprint()
                    if fp != sse_last["fp"]:
                        sse_last["fp"] = fp
                        self.wfile.write(("event: board\ndata: " + fp + "\n\n").encode("utf-8"))
                        self.wfile.flush()
                    counter += 1
                    if counter % 5 == 0:
                        self.wfile.write(b": heartbeat\n\n")
                        self.wfile.flush()
                    time.sleep(3)
            except (BrokenPipeError, ConnectionResetError, OSError):
                pass

    print(f"看板状态服务: http://{bind}:{port}  (Ctrl+C 停止)")
    try:
        ThreadingHTTPServer((bind, port), Handler).serve_forever()
    except KeyboardInterrupt:
        pass
    return 0



def validate_groups(root: Path) -> list:
    """全局任务组校验: 组 ID 格式/一致性/引用存在/同组/无自引用/无环."""
    problems = []
    by_id = {}
    for state, entry in iter_entries(root):
        by_id[entry_id(entry)] = (state, entry)
    records = {}
    for task_id, (state, entry) in by_id.items():
        gid, deps = group_fields(read_card(entry))
        has_dep_line = bool(re.search(r"^前置任务:\s*(\S.*)?$",
                                      section_body(read_card(entry), "讨论与决策"),
                                      re.M))
        if gid or deps or has_dep_line:
            records[task_id] = (gid, deps)
        if gid and not GROUP_ID_RE.match(gid):
            problems.append(f"[{state}] {task_id}: 任务组 ID 格式错误: {gid}")
        if deps and not gid:
            problems.append(f"[{state}] {task_id}: 有前置任务但缺「任务组」行")
        if gid and not deps and not has_dep_line:
            problems.append(f"[{state}] {task_id}: 有「任务组」但缺「前置任务」行")
    for task_id, (gid, deps) in records.items():
        for d in deps:
            if d == task_id:
                problems.append(f"{task_id}: 不能前置自己")
                continue
            other = by_id.get(d)
            if other is None:
                problems.append(f"{task_id}: 前置任务不存在: {d}")
                continue
            other_gid, _ = records.get(d, (None, []))
            if gid and other_gid and gid != other_gid:
                problems.append(f"{task_id}: 前置任务 {d} 属于其他任务组 ({other_gid})")
    # 环检测
    visiting, visited = set(), set()
    def dfs(tid, chain):
        if tid in visiting:
            problems.append("任务组存在依赖环: " + " -> ".join(chain + [tid]))
            return
        if tid in visited:
            return
        visiting.add(tid)
        _, deps = records.get(tid, (None, []))
        for d in deps:
            if d in records:
                dfs(d, chain + [tid])
        visiting.discard(tid)
        visited.add(tid)
    for tid in records:
        dfs(tid, [])
    return problems


def cmd_check(args) -> int:
    root = board_root()
    problems = []
    seen = {}
    for state, entry in iter_entries(root):
        task_id = entry_id(entry)
        # archived/trash 是归档记录, 豁免 ID 格式校验 (遗留旧格式卡可归档留档);
        # 活跃状态 (backlog/todo/working/done) 严格符合 YYYYMMDD-slug-task.
        if not TASK_ID_RE.match(task_id) and state not in ("archived", "trash"):
            problems.append(f"[{state}] 任务 ID 格式错误: {entry.name}")
        if task_id in seen:
            problems.append(f"[{state}] 重复任务 ID: {task_id} (另见 {seen[task_id]})")
        else:
            seen[task_id] = str(entry)
        text = read_card(entry)
        if state in ("todo", "working"):
            problems += validate_contract(text, task_id)
        if state == "done":
            if not re.search(r"^- 结果:\s*completed\s*$", text, re.M):
                problems.append(f"[done] {task_id} 缺 `结果: completed`")
            summary = section_body(text, "完成总结")
            summary_ok = bool(summary) and not has_placeholder(summary)
            report_ok = is_large(entry) and (entry / "report.md").exists() \
                and read_any_text(entry / "report.md").strip()
            if not summary_ok and not report_ok:
                problems.append(f"[done] {task_id} 缺「完成总结」或 report.md")
    problems += validate_groups(root)
    if problems:
        print("看板存在问题:")
        for p in problems:
            print(f"  - {p}")
        return 1
    print("看板 OK")
    return 0


def cmd_session(args) -> int:
    """kanban session [name] [--agent dsh|codex|claude] — 一条命令起/入 管理会话 (tmux).
    以 tmux 会话(名=name, 默认取当前 cwd 目录名) 运行指定 agent CLI:
      dsh(默认) -> dsh --profile tui;  codex -> codex;  claude -> claude.
    该 tmux 会话已存在则 attach; 否则新建会话并启动该 CLI."""
    name = None
    agent = "dsh"
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--agent":
            i += 1
            if i >= len(args):
                raise KanbanError("--agent 需要 dsh|codex|claude")
            agent = args[i]
            if agent not in ("dsh", "codex", "claude"):
                raise KanbanError("--agent 只能是 dsh|codex|claude")
        elif a.startswith("-"):
            raise KanbanError(f"未知选项: {a}")
        elif name is None:
            name = a
        else:
            raise KanbanError(f"未知参数: {a}")
        i += 1
    if not name:
        name = re.sub(r"[^A-Za-z0-9_.-]+", "-", Path.cwd().name) or "dsh-session"
    cli = {"dsh": ["dsh", "--profile", "tui"],
           "codex": ["codex"],
           "claude": ["claude"]}[agent]
    if shutil.which("tmux") is None:
        raise KanbanError("未找到 tmux; 请先安装 (apt install tmux)")
    # 尽量在项目根启动, 让外部 agent (claude/codex) 能读到 AGENTS.md 与 onevoke skill;
    # 也保证 kanban auto 的 board_root() 落在正确看板.
    try:
        proj = board_root().parent
        if (proj / "kanban").is_dir():
            os.chdir(proj)
    except Exception:
        pass
    if shutil.which(cli[0]) is None:
        raise KanbanError(f"未找到 {agent} CLI ({cli[0]}); 请安装或加入 PATH")
    has = subprocess.run(["tmux", "has-session", "-t", name], capture_output=True)
    if has.returncode == 0:
        print(f"attach 到已有 tmux 会话 [{name}] ({agent})...")
        subprocess.run(["tmux", "attach", "-t", name])
        return 0
    print(f"新建 tmux 会话 [{name}], 运行 {agent}...")
    subprocess.run(["tmux", "new-session", "-d", "-s", name] + cli)
    # 若项目配置了 plan 模型, 等 DSH TUI 就绪后自动切过去 (指挥/规划会话用 plan 模型)
    cfg = _parse_project_config()
    plan = (cfg.get("plan") or {})
    if agent == "dsh" and plan.get("provider") and plan.get("model"):
        try:
            target = f"{name}:0"
            for _ in range(25):
                time.sleep(2)
                cap = subprocess.run(["tmux", "capture-pane", "-t", target, "-p"],
                                     capture_output=True, text=True, timeout=10)
                if cap.returncode == 0 and ("dsh >" in cap.stdout or "dsh>" in cap.stdout):
                    break
            subprocess.run(["tmux", "send-keys", "-t", target, "-l", f"/model {plan['provider']}/{plan['model']}"])
            subprocess.run(["tmux", "send-keys", "-t", target, "Enter"])
            time.sleep(3)
            print(f"已自动应用 plan 模型: {plan['provider']}/{plan['model']}")
        except Exception as exc:
            print(f"自动切 plan 模型失败 (可手动 /model): {exc}")
    print(f"attach 到会话 [{name}]... (QuickTUI 可见)")
    subprocess.run(["tmux", "attach", "-t", name])
    return 0


def cmd_auto(args) -> int:
    """kanban auto [--max N] [--interval S] [--gate done|work] [--deps 'slug=d1,d2;slug2=d3'] [--chain 'a,b,c']
    内置依赖调度器 (替代外部 orchestrator): 循环检查看板, 某任务依赖满足且未启动时自动 pick+start;
    并发上限 --max (默认取 limits.max_concurrent_tasks, 0=不限); 轮询 --interval 秒; Ctrl-C 停止.
    验收门禁 --gate:
      work (默认) 前置任务「工作已完成」即放行下一个 — done 或 (working 且 结果: completed, 即到达等待验收),
                  这样用户不点验收(如夜间睡觉)流水线也继续;
      done  前置任务必须进入 done(=已确认验收) 才开下一个 (严格按验收).
    依赖来源优先级: --deps 显式 map(slug=dep1,dep2;...) > --chain 线性(每个依赖之前所有) > 读卡片「前置任务」."""
    max_n, interval, gate = 0, 15, "work"
    deps_map, chain = {}, []
    rest = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--max":
            i += 1
            if i >= len(args):
                raise KanbanError("--max 需要数字")
            max_n = int(args[i])
        elif a == "--interval":
            i += 1
            if i >= len(args):
                raise KanbanError("--interval 需要数字")
            interval = int(args[i])
        elif a == "--gate":
            i += 1
            if i >= len(args):
                raise KanbanError("--gate 需要 done|work")
            gate = args[i]
            if gate not in ("done", "work"):
                raise KanbanError("--gate 只能是 done|work")
        elif a == "--deps":
            i += 1
            if i >= len(args):
                raise KanbanError("--deps 需要 'slug=d1,d2;...'")
            for part in args[i].split(";"):
                if "=" in part:
                    k, v = part.split("=", 1)
                    deps_map[k.strip()] = [d.strip() for d in v.split(",") if d.strip()]
        elif a == "--chain":
            i += 1
            if i >= len(args):
                raise KanbanError("--chain 需要 'a,b,c'")
            chain = [x.strip() for x in args[i].split(",") if x.strip()]
        else:
            rest.append(a)
        i += 1
    if rest:
        raise KanbanError(f"未知参数: {' '.join(rest)}")

    root = board_root()
    # slug -> task_id: 从看板实际任务 id 推导 (YYYYMMDD-slug-task), 不依赖今天的日期.
    # 状态每次实时扫描看板, 不缓存 (否则前端把依赖移 done 后, auto 看到的仍是旧状态).
    slug_to_tid = {}
    for state, entry in iter_entries(root):
        tid = entry_id(entry)
        slug = tid.split("-", 1)[1].rsplit("-task", 1)[0] if tid.endswith("-task") else tid
        slug_to_tid[slug] = tid
    cfg = _parse_project_config()
    if max_n == 0:
        try:
            max_n = int((cfg.get("limits") or {}).get("max_concurrent_tasks", 0) or 0)
        except Exception:
            max_n = 0

    def _state(slug: str) -> str:
        tid = slug_to_tid.get(slug)
        if not tid:
            return ""
        st, _ = find_card_any(root, tid)
        return st or ""

    def _ready(slug: str) -> bool:
        """验收门禁: 前置任务是否"已放行"下一个.
        work: done 或 (working 且 结果: completed = 到达等待验收) 即放行;
        done: 必须 done(=已确认验收)."""
        st = _state(slug)
        if st == "done":
            return True
        if gate == "work" and st == "working":
            tid = slug_to_tid.get(slug)
            if tid:
                _, entry = find_card_any(root, tid)
                if entry and re.search(r"^- 结果:\s*completed\s*$", read_card(entry), re.M):
                    return True
        return False

    def _count_working() -> int:
        n = 0
        for s, e in iter_entries(root):
            if s != "working":
                continue
            if gate == "work" and re.search(r"^- 结果:\s*completed\s*$", read_card(e), re.M):
                continue  # --gate work: 待验收(工作已完成)不再占并发位, 让链条继续
            n += 1
        return n

    print(f"auto-scheduler: deps={bool(deps_map)} chain={bool(chain)} 卡片前置={(not deps_map and not chain)} "
          f"max={max_n or '不限'} interval={interval}s gate={gate}")
    while True:
        if deps_map:
            slugs = list(deps_map.keys())
        elif chain:
            slugs = list(chain)
        else:
            slugs = [tid.split("-", 1)[1].rsplit("-task", 1)[0]
                     for s, e in iter_entries(root) if s in ("backlog", "todo")]
        wc = _count_working()
        # 每次轮询先扫描全部 working 卡: 会话中断(有会话记录但无 dsh 进程)自动恢复
        for s, e in iter_entries(root):
            if s != "working":
                continue
            tid = entry_id(e)
            try:
                text = read_card(e)
                m = re.search(r"^会话:\s*(\S+)", section_body(text, "讨论与决策"), re.M)
                if m and not _session_running(m.group(1).strip()):
                    print(f"[{now()}] 恢复中断会话 {tid} ({m.group(1)})")
                    try:
                        cmd_resume([tid])
                    except KanbanError as exc:
                        print(f"[{now()}] resume {tid} 失败: {exc}")
            except Exception as exc:
                print(f"[{now()}] 检查 {tid} 会话状态失败: {exc}")
        for slug in slugs:
            tid = slug_to_tid.get(slug)
            if not tid:
                continue
            st = _state(slug)
            if st in ("working", "done"):
                continue
            if deps_map:
                dep_slugs = deps_map.get(slug, [])
            elif chain:
                try:
                    dep_slugs = chain[:chain.index(slug)]
                except ValueError:
                    dep_slugs = []
            else:
                _, entry = find_card_any(root, tid)
                _, dep_slugs = group_fields(read_card(entry)) if entry else (None, [])
            # dep_slugs 可能以 task id 或 slug 形式给出; 归一化成 slug 再判 done
            dep_ok = True
            for d in dep_slugs:
                d_slug = d.split("-", 1)[1].rsplit("-task", 1)[0] if d.endswith("-task") else d
                if not _ready(d_slug):
                    dep_ok = False
                    break
            if not dep_ok:
                continue
            if max_n and wc >= max_n:
                print(f"[{now()}] 并发上限 {wc}/{max_n}, 等待 {tid}")
                break
            if st == "backlog":
                print(f"[{now()}] pick {tid}")
                try:
                    cmd_pick([tid])
                except KanbanError as exc:
                    print(f"[{now()}] pick {tid} 失败: {exc}")
                    continue
                st = "todo"
            if st == "todo":
                print(f"[{now()}] start {tid}")
                try:
                    cmd_start([tid])
                except KanbanError as exc:
                    print(f"[{now()}] start {tid} 失败: {exc}")
                wc += 1
        time.sleep(interval)


def _upsert_section(text: str, section: str, body: str) -> str:
    """在卡片文本里 upsert 一个非必填章节 (在 ## 完成总结 之前插入, 幂等替换)."""
    marker = f"## {section}\n"
    block = marker + body.rstrip("\n") + "\n"
    if marker in text:
        # 替换已有章节: 从 marker 到下一个 "## " (或末尾)
        head, rest = text.split(marker, 1)
        tail = re.split(r"\n## ", rest, 1)
        tail_part = "\n## " + tail[1] if len(tail) > 1 else ""
        return head + block + tail_part.lstrip("\n")
    # 插入到 ## 完成总结 之前
    if "## 完成总结" in text:
        return text.replace("## 完成总结", block + "\n## 完成总结", 1)
    return text.rstrip("\n") + "\n\n" + block


def cmd_usage(args) -> int:
    """kanban usage [task-id ...] [--write] — 每个任务的 token 用量与耗时 (读 DSH 会话日志 session.jsonl.zstd).
    无参列出全部卡; 可传一个或多个 task-id. --write 把指标写进任务卡的「用量指标」章节.
    需要 python3 + zstandard (或 zstd CLI 可用)."""
    write = "--write" in args
    ids = [a for a in args if a.endswith("-task")]
    root = board_root()
    project = root.parent
    # DSH sessions 目录名 = cwd sanitize: 去前导 '/', 替换 '/' -> '-', 包 '--...--'
    seg = str(project).strip().rstrip("/").lstrip("/").replace("/", "-").replace("\\", "-")
    dsh_home = os.environ.get("DSH_HOME") or os.path.expanduser("~/.dsh")
    sess_parent = os.path.join(dsh_home, "sessions", f"--{seg}--")

    def _reader(path):
        """返回可迭代每行已解析对象的生成器; 失败返回 None."""
        try:
            import zstandard as zstd
            f = open(path, "rb")
            r = zstd.ZstdDecompressor().stream_reader(f)
            return r
        except Exception:
            return None

    tasks = [(entry_id(entry), state) for state, entry in iter_entries(root)
             if not ids or entry_id(entry) in ids]
    if not tasks:
        print(f"无匹配任务 (会话目录: {sess_parent})")
        return 0

    rows = []
    for tid, state in tasks:
        jf = os.path.join(sess_parent, f"kb-{tid}", "session.jsonl.zstd")
        if not os.path.isfile(jf):
            rows.append((tid, state, 0, 0, 0, 0, 0, 0, 0, 0))
            continue
        agg = {"i": 0, "o": 0, "r": 0, "c": 0, "m": 0, "t": 0}
        min_t = max_t = None
        r = _reader(jf)
        if r is None:
            rows.append((tid, state, 0, 0, 0, 0, 0, 0, 0, 0))
            continue
        try:
            buf = b""
            while True:
                chunk = r.read(1 << 20)
                if not chunk:
                    break
                buf += chunk
                while b"\n" in buf:
                    line, buf = buf.split(b"\n", 1)
                    if not line.strip():
                        continue
                    try:
                        o = json.loads(line.decode("utf-8", "replace"))
                    except Exception:
                        continue
                    if not isinstance(o, dict):
                        continue
                    t = o.get("type")
                    d = o.get("data")
                    tt = o.get("time") or (d.get("time") if isinstance(d, dict) else None)
                    if isinstance(tt, (int, float)):
                        if min_t is None or tt < min_t:
                            min_t = tt
                        if max_t is None or tt > max_t:
                            max_t = tt
                    if t == "assistant/message" and isinstance(d, dict):
                        agg["m"] += 1
                        u = d.get("usage") or {}
                        agg["i"] += int(u.get("inputTokens") or 0)
                        agg["o"] += int(u.get("outputTokens") or 0)
                        agg["r"] += int(u.get("reasoningTokens") or 0)
                        agg["c"] += int(u.get("cacheReadTokens") or 0)
                    elif t == "tool/call":
                        agg["t"] += 1
        finally:
            r.close()
        total = agg["i"] + agg["o"] + agg["r"]
        wall = round((max_t - min_t) / 1000.0) if (min_t is not None and max_t is not None) else 0
        rows.append((tid, state, agg["i"], agg["o"], agg["r"], agg["c"], agg["m"], agg["t"], total, wall))

    if write:
        written = 0
        for tid, state, i, o, r, c, m, t, total, wall in rows:
            if not (i or o or r):
                continue  # 无会话/无解码, 不写
            _, entry = find_card(root, tid)
            text = read_card(entry)
            body = (f"- 耗时: {wall}s\n"
                    f"- input: {i} / output: {o} / reasoning: {r} / cache: {c/1e6:.1f}M tokens\n"
                    f"- 总计: {total} tokens; 消息 {m} 条, 工具调用 {t} 次\n"
                    f"- 详情: `kanban usage {tid}`")
            text2 = _upsert_section(text, "用量指标", body)
            if text2 != text:
                write_entry(entry, text2)
                written += 1
        if written:
            print(f"已写入 {written} 张卡的「用量指标」章节")

    print(f"Board: {project}   (会话目录: {sess_parent})")
    print(f"{'task':34s} {'state':9s} {'input':>8} {'output':>8} {'reason':>7} {'cache(M)':>9} {'msgs':>5} {'tools':>5} {'total':>9} {'wall(s)':>8}")
    for tid, state, i, o, r, c, m, t, total, wall in rows:
        print(f"{tid:34s} {state:9s} {i:>8} {o:>8} {r:>7} {c/1e6:>9.1f} {m:>5} {t:>5} {total:>9} {wall:>8.0f}")
    print("提示: 会话日志无 zstd 解码器时该行为 0; 需要 python3+zstandard 或 zstd CLI.")
    return 0


def main(argv) -> int:
    if not argv or argv[0] in ("-h", "--help"):
        print(USAGE)
        return 0 if argv else 1
    cmd, args = argv[0], argv[1:]
    try:
        if cmd == "init":
            return cmd_init(args)
        if cmd == "design":
            return cmd_design(args)
        if cmd == "list":
            return cmd_list(args)
        if cmd == "show":
            return cmd_show(args)
        if cmd == "new":
            return cmd_new(args)
        if cmd == "req-status":
            return cmd_req_status(args)
        if cmd == "e2e":
            return cmd_e2e(args)
        if cmd == "visual":
            return cmd_visual(args)
        if cmd == "upgrade":
            return cmd_upgrade(args)
        if cmd == "pick":
            return cmd_pick(args)
        if cmd == "start":
            return cmd_start(args)
        if cmd == "resume":
            return cmd_resume(args)
        if cmd == "move":
            return cmd_move(args)
        if cmd == "group":
            return cmd_group(args)
        if cmd == "web":
            return cmd_web(args)
        if cmd == "check":
            return cmd_check(args)
        if cmd == "auto":
            return cmd_auto(args)
        if cmd == "usage":
            return cmd_usage(args)
        if cmd == "session":
            return cmd_session(args)
        raise KanbanError(f"未知命令: {cmd}")
    except KanbanError as exc:
        print(f"kanban: {exc}", file=sys.stderr)
        return 2
    except KeyboardInterrupt:
        print("已中断", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
