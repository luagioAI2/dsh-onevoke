#!/usr/bin/env python3
"""kanban — 文件看板 CLI (Onevoke 思想, 零第三方依赖, 与 DSH 插件 dsh-onevoke 配套).

看板 = 文件系统目录, 不进 Git, 唯一实例在主 worktree 根 (KANBAN_DIR 可覆盖):

    kanban/
      backlog/  todo/  working/  done/  archived/  trash/

状态机: backlog -> todo -> working -> done -> archived; 任意状态 -> trash (仅用户明确要求).
任务 ID: YYYYMMDD-short-slug-task. 任务形态:
  小任务: <state>/<task-id>.md 单文件卡
  大任务: <state>/<task-id>/ 目录, 含 spec.md (必需) + plan.md (按需) + report.md (完成时)
任务组: 独立卡之间的关系, 卡内「讨论与决策」记录:
  任务组: YYYYMMDD-short-slug-group
  前置任务: <同组任务 ID, 逗号分隔 | N/A>

命令: init / list / show / new / pick / start / move / check / group / upgrade
"""

import datetime
import html
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import unquote
from pathlib import Path

STATES = ("backlog", "todo", "working", "done", "archived", "trash")
TYPES = ("feature", "bug", "chore", "research")
TASK_ID_RE = re.compile(r"^\d{8}-[a-z0-9-]+-task$")
GROUP_ID_RE = re.compile(r"^\d{8}-[a-z0-9-]+-group$")
SLUG_RE = re.compile(r"^[a-z0-9-]+$")

# 进 todo/ 前必须非空且不留占位符的契约章节
REQUIRED_SECTIONS = ("任务目标", "预期成果", "验收条件", "不在本轮范围")
PLACEHOLDERS = ("<填写>", "<完成前留空>", "TODO", "TBD", "待填", "填写")

USAGE = """用法:
  kanban init [path] [--agents]           幂等创建看板和 6 个状态目录; --agents 另给项目 AGENTS.md 写 opt-in 入口
  kanban design init                      初始化需求仓库 requirements/ (program|art|numeric + specs 规范)
  kanban design new --type program|art|numeric --module <模块> --title <标题> [--pri P0|P1|P2|P3]
                                           新建需求文件 (自动编号 REQ-P/A/N-NNN)
  kanban design list [--type t] [--module m] [--status s]   列出需求仓库 (含看板映射)
  kanban design show <REQ-ID|文件路径>    查看需求文件
  kanban design break <REQ-ID>           AI 语义拆分需求为多张任务卡 (数量由 AI 定; 子卡引用父需求)
  kanban list [state] [--mobile] [--type t] [--module m]  列出卡片 (默认全部状态; 大任务标 [large])
  kanban show <task-id>                    显示卡片 (大任务: spec + plan + report)
  kanban new [--large] [--group <gid>] [--deps id1,id2] [--review light|standard|full] [--spec-file <需求文档|需求仓库> --req REQ-xxx] <feature|bug|chore|research> <slug> <标题...>
  kanban req-status [需求文档|需求仓库] [--type t] [--module m]  核对需求条目与看板卡状态
  kanban e2e <task-id>                  L3 浏览器 E2E (独立阶段)
  kanban visual <task-id>               L4 视觉回归 (基线截图 diff)
  kanban pick [task-id]                    backlog -> todo (校验契约完整)
  kanban start [--no-window] [--ignore-deps] [--agent dsh|claude|codex] [task-id]
                                           todo -> working; 默认拉 dsh 会话; --agent claude|codex
                                           自动开 tmux 窗口跑对应 CLI (QuickTUI 可见, 校验依赖)
  kanban resume [--all | <task-id>]     恢复卡片记录的会话 (--all/无参=全部 working 卡; 崩溃/中断后续跑)
  kanban move <task-id> <todo|working|done|archived|trash>
  kanban group <group-id>                  任务组依赖状态 (成员/前置/就绪)
  kanban web [--port 8090] [--bind 0.0.0.0]  看板状态服务 (HTML + JSON API)
  kanban upgrade <task-id>                 小任务 -> 大任务 (仅 backlog/working)
  kanban check                             列出全部无效入口, 有则非零退出
  kanban auto [--max N] [--interval S] [--gate done|work] [--deps 'slug=dep,dep;...'] [--chain 'a,b,c']
                                            内置依赖调度器: 前置任务"放行"且本任务未启动时自动 pick+start;
                                            --gate work(默认): 前置工作已完成(done 或 working 且结果completed=待验收)即放行下一个;
                                            --gate done: 前置进入 done(已确认验收) 才放行; --max 并发上限, --interval 轮询秒; Ctrl-C 停止
  kanban usage [task-id ...]           每个任务的 token 用量与耗时 (读 DSH 会话日志; 需 python3+zstandard)
  kanban session [name] [--agent dsh|codex|claude]
                                            一条命令起/入 管理会话 (tmux): 新建 tmux 会话并跑 dsh(默认)/codex/claude, 已存在则 attach"""


class KanbanError(Exception):
    pass


def board_root() -> Path:
    env = os.environ.get("KANBAN_DIR")
    if env:
        return Path(env).resolve()
    try:
        out = subprocess.run(
            ["git", "worktree", "list", "--porcelain"],
            capture_output=True, text=True, check=False, timeout=10,
        )
        if out.returncode == 0:
            for line in out.stdout.splitlines():
                if line.startswith("worktree "):
                    return Path(line[len("worktree "):].strip()) / "kanban"
    except Exception:
        pass
    # 向上查找项目根下的 kanban/ (cwd 不是项目根时也能用, 避免 `kanban auto` 因 cwd 不对解析到别的看板)
    cur = Path.cwd()
    for _ in range(20):
        if (cur / "kanban").is_dir():
            return cur / "kanban"
        if cur.parent == cur:
            break
        cur = cur.parent
    return Path.cwd() / "kanban"


def now() -> str:
    return datetime.datetime.now().strftime("%Y-%m-%d %H:%M")


def today() -> str:
    return datetime.datetime.now().strftime("%Y%m%d")


def ensure_board(root: Path) -> None:
    for state in STATES:
        (root / state).mkdir(parents=True, exist_ok=True)


def entry_id(entry: Path) -> str:
    """入口 ID: 文件取 stem, 目录取名字."""
    return entry.stem if entry.is_file() else entry.name


def is_large(entry: Path) -> bool:
    return entry.is_dir()


def spec_path(entry: Path) -> Path:
    return entry if entry.is_file() else entry / "spec.md"


def read_any_text(path: Path) -> str:
    """读文本, 容忍编码偏差 (外部写入的 plan/report.md 可能是 GBK/其他): UTF-8 优先, 失败用替换符."""
    try:
        return path.read_text(encoding="utf-8")
    except UnicodeDecodeError:
        return path.read_text(encoding="utf-8", errors="replace")


def read_card(entry: Path) -> str:
    try:
        return read_any_text(spec_path(entry))
    except OSError as exc:
        raise KanbanError(f"读取卡片失败 {spec_path(entry)}: {exc}")


def iter_entries(root: Path):
    """yield (state, entry) 遍历看板全部卡 (小任务文件 + 大任务目录)."""
    for state in STATES:
        state_dir = root / state
        if not state_dir.is_dir():
            continue
        for entry in sorted(state_dir.iterdir()):
            if entry.is_file() and entry.suffix == ".md":
                yield state, entry
            elif entry.is_dir() and (entry / "spec.md").is_file():
                yield state, entry


def find_card(root: Path, task_id: str):
    if not TASK_ID_RE.match(task_id):
        raise KanbanError(f"任务 ID 格式错误: {task_id} (应形如 {today()}-short-slug-task)")
    for state, entry in iter_entries(root):
        if entry_id(entry) == task_id:
            return state, entry
    raise KanbanError(f"找不到任务: {task_id}")


def find_card_any(root: Path, task_id: str):
    """允许 task 或 group id; 找不到返回 (None, None)."""
    for state, entry in iter_entries(root):
        if entry_id(entry) == task_id:
            return state, entry
    return None, None


def card_title(text: str) -> str:
    for line in text.splitlines():
        if line.startswith("# "):
            return line[2:].strip()
    return "(无标题)"


def section_body(text: str, section: str) -> str:
    lines = text.splitlines()
    out, active = [], False
    for line in lines:
        if line.startswith("## "):
            if active:
                break
            active = line[2:].strip() == section
            continue
        if active:
            out.append(line)
    return "\n".join(out).strip()


def has_placeholder(body: str) -> bool:
    return any(p in body for p in PLACEHOLDERS)


def validate_contract(text: str, where: str) -> list:
    problems = []
    for section in REQUIRED_SECTIONS:
        body = section_body(text, section)
        if not body:
            problems.append(f"{where}: 缺少「{section}」")
        elif has_placeholder(body):
            problems.append(f"{where}: 「{section}」仍有占位符, 未填写完整")
    return problems


def group_fields(text: str):
    """解析「讨论与决策」里的任务组关系, 返回 (group_id, [deps]) 或 (None, [])."""
    body = section_body(text, "讨论与决策")
    m = re.search(r"^任务组:\s*(\S+)", body, re.M)
    gid = m.group(1).strip() if m else None
    m = re.search(r"^前置任务:\s*(.+)$", body, re.M)
    deps = []
    if m:
        raw = m.group(1).strip()
        if raw and raw.upper() != "N/A":
            deps = [d.strip() for d in re.split(r"[,，\s]+", raw) if d.strip()]
    return gid, deps


def dump_card(entry: Path) -> None:
    print(f"===== {entry} =====")
    print(read_card(entry))
    if is_large(entry):
        for extra in ("plan.md", "report.md"):
            p = entry / extra
            if p.exists():
                print(f"\n----- {extra} -----")
                print(read_any_text(p))


def template_card(title: str, kind: str) -> str:
    return f"""# {title}

- 类型: {'Feature' if kind == 'feature' else kind.capitalize()}
- 创建时间: {now()}
- 负责人:
- 开始时间:
- 完成时间:
- 任务分支:
- 审核: 标准
- 结果:

## 任务目标

<填写>

## 用户决策

N/A

## 预期成果

<填写>

## 验收条件

- [ ] <填写>

## 威胁模型

N/A

## 红线

- <禁止事项: 不可改的模块/数据/环境, 触发即停下报告; 无则 N/A>

## 不在本轮范围

- <填写>

## 讨论与决策

<关键结论; 会话 id 也记录在这里>

## 实施与验证

<计划, 分支, commit, 验证命令, 结果>

## 完成总结

<完成前留空>
"""


def stamp_group(text: str, gid: str, deps: list) -> str:
    """在「讨论与决策」开头写入任务组关系 (幂等: 已有则不改)."""
    cur, _ = group_fields(text)
    if cur:
        return text
    dep_line = "N/A" if not deps else ", ".join(deps)
    return text.replace(
        "## 讨论与决策\n",
        f"## 讨论与决策\n\n任务组: {gid}\n前置任务: {dep_line}\n", 1,
    )


def write_entry(entry: Path, text: str) -> None:
    spec_path(entry).write_text(text, encoding="utf-8")


def _exclude_board(root: Path) -> None:
    """把看板目录加进主 worktree 的 .git/info/exclude (Onevoke 同款: 本地排除,
    不改 .gitignore, 不提交)。这样 git status 不会把 kanban/ 显示为未跟踪,
    审核前置条件 (worktree 干净) 才能满足。"""
    try:
        main = None
        out = subprocess.run(
            ["git", "worktree", "list", "--porcelain"],
            capture_output=True, text=True, check=False, timeout=10,
        )
        for line in out.stdout.splitlines():
            if line.startswith("worktree "):
                main = Path(line[len("worktree "):].strip())
                break
        if not main:
            return
        git_dir = subprocess.run(
            ["git", "-C", str(main), "rev-parse", "--git-dir"],
            capture_output=True, text=True, check=False, timeout=10,
        ).stdout.strip()
        exclude = Path(git_dir) / "info" / "exclude"
        if not exclude.is_file():
            return
        entry = "kanban/"
        text = exclude.read_text(encoding="utf-8", errors="replace")
        lines = text.splitlines()
        changed = False
        for extra in ("kanban/", ".dsh-onevoke.yml", ".dsh-onevoke.local.yml"):
            if extra not in lines:
                lines.append(extra)
                changed = True
        if changed:
            exclude.write_text("\n".join(lines) + "\n", encoding="utf-8")
    except Exception:
        pass  # 非 git 项目或排除失败不致命


AGENTS_POINTER_SECTION = """## dsh-onevoke 看板流程 (kanban init --agents 写入, 幂等)

本仓库任务遵循 dsh-onevoke 看板流程, 无论你在哪个智能体环境 (DSH 会话 / Claude /
Codex / 其他 agentic CLI) 都能驱动:

1. 先读流程契约: `~/.agents/skills/onevoke/SKILL.md`(DSH 会话里用 skill 工具加载同名技能; 外部智能体直接读该文件)。
2. 读 `kanban/RULES.md` 与 `kanban/MEMORY.md`(若存在)。
3. 用 `kanban` CLI 驱动: 用户说"初始化看板" → `kanban init`(+`--agents`)/`kanban design init`/`kanban check`;
   用户给需求 → `kanban new` 建卡 → `kanban pick` → `kanban start`(卡进 working)。
4. 任务执行两种模式按需选: ① 外部 CLI 执行 —— `kanban start --agent claude|codex` 自动开
   tmux `kb-*` 窗口跑对应 CLI (QuickTUI 可见), 任务自己 worktree+提交+`onevoke-review` 审核;
   ② dsh 会话执行 —— 默认 `kanban start` 拉起的 tmux `kb-*` 窗口跑 dsh TUI (QuickTUI 可看)。
5. 审核用 `onevoke-review`(证据+门禁)交给 subagent 只读执行; 验收门禁不变 (用户确认后才集成)。
"""


def _write_agents_pointer(root: Path) -> None:
    """kanban init --agents: 给项目根 AGENTS.md 写 opt-in 入口 (创建或追加, 幂等).
    root = 看板目录; 项目根 = root.parent (含 kanban/ 的目录)."""
    project = root.parent
    agents = project / "AGENTS.md"
    marker = "dsh-onevoke 看板流程"
    if agents.exists():
        text = agents.read_text(encoding="utf-8", errors="replace")
        if marker in text:
            print(f"AGENTS.md 已含 onevoke 入口, 跳过: {agents}")
            return
        if not text.endswith("\n"):
            text += "\n"
        text += "\n" + AGENTS_POINTER_SECTION
        agents.write_text(text, encoding="utf-8")
        print(f"已追加 onevoke 入口到: {agents}")
    else:
        agents.write_text(AGENTS_POINTER_SECTION, encoding="utf-8")
        print(f"已创建项目 AGENTS.md (onevoke opt-in 入口): {agents}")
    print("提示: AGENTS.md 需提交 git; 外部智能体 (Claude/Codex) 与 DSH 会话都会读到它.")


def cmd_init(args) -> int:
    with_agents = "--agents" in args
    path_args = [a for a in args if not a.startswith("--")]
    root = Path(path_args[0]).resolve() if path_args else board_root()
    ensure_board(root)
    _exclude_board(root)
    _write_board_templates(root)
    if with_agents:
        _write_agents_pointer(root)
    print(f"看板就绪: {root}")
    print("状态目录: " + ", ".join(STATES))
    return 0


BOARD_CONFIG_TEMPLATE = """# 看板配置 (kanban/.dsh-onevoke.yml) — 本看板的模型/审核/权限设置
# 优先级: 会话 /model > 本项目配置 > home (~/.dsh/onevoke/reviewers.yml) > 会话默认
