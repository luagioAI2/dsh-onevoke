def _write_board_templates(root: Path) -> None:
    """kanban init 生成看板配置/规则/记忆模板 (仅当不存在, 幂等)."""
    for name, content in ((".dsh-onevoke.yml", BOARD_CONFIG_TEMPLATE),
                          ("RULES.md", BOARD_RULES_TEMPLATE),
                          ("MEMORY.md", BOARD_MEMORY_TEMPLATE)):
        p = root / name
        if not p.exists():
            p.write_text(content, encoding="utf-8")
            print(f"已生成模板: {p} (注释掉即默认, 按需修改)")


def _req_root() -> Path:
    """需求仓库根目录: 项目根/requirements (与 kanban/ 平级)."""
    return board_root().parent / "requirements"


def _req_next_num(req_dir: Path, rtype: str) -> int:
    """该类型目录下下一编号: 扫描 REQ-<TYPE>-NNN.md 取最大 + 1."""
    prefix = "REQ-" + rtype[0].upper() + "-"
    nums = []
    if req_dir.is_dir():
        for f in req_dir.glob("*.md"):
            m = re.match(rf"^{re.escape(prefix)}(\d{{3}})", f.name)
            if m:
                nums.append(int(m.group(1)))
    return (max(nums) + 1) if nums else 1


def _req_status_rank(status: str) -> int:
    return {"待评审": 0, "已拍板": 1, "已转看板": 2, "已实现": 3}.get(status, 9)


def _sanitize_slug(s: str) -> str:
    s = re.sub(r"[^a-z0-9]+", "-", (s or "").lower()).strip("-")
    return s or "req"


def _extract_json_array(text: str):
    """从 LLM 输出里提取 JSON 数组 (容忍 ```json 围栏/前后杂文本)."""
    if not text:
        return None
    text = re.sub(r"```(?:json)?", "", text).strip()
    start = text.find("[")
    end = text.rfind("]")
    if start == -1 or end == -1 or end < start:
        return None
    try:
        arr = json.loads(text[start:end + 1])
        return arr if isinstance(arr, list) and arr else None
    except Exception:
        return None


def _break_ai(target: str, req) -> int:
    """AI 拆解: 用 DSH plan 模型 (headless) 语义分解需求, 再把每个子项落到看板卡."""
    title, fields = req["title"], req["fields"]
    goal = fields.get("期望") or ""
    acc = fields.get("验收") or ""
    scope = fields.get("范围") or ""
    module = fields.get("模块", "")
    type_label = REQ_TYPE_LABELS.get(fields.get("类型", ""), fields.get("类型", ""))
    prompt = (
        "你是需求拆解专家。把下面的需求拆成若干**互不重叠、可独立交付**的子任务, "
        "每个小到一次改动即可完成且验收聚焦; 基于需求的实际内容决定拆几张(通常3-8张), 不要机械按验收项条数。\n\n"
        f"需求标题: {title}\n需求描述: {goal}\n验收标准:\n{acc}\n范围(不做): {scope or 'N/A'}\n\n"
        "返回严格 JSON 数组, 每个元素: {\"slug\": \"英文小写连字符标识(如 stats-query-api)\", "
        "\"title\": \"子任务标题\", \"description\": \"子任务描述\", "
        "\"acceptance\": [\"验收项1\", \"验收项2\"]}。slug 必须只含小写字母/数字/连字符且能反映该子任务。只输出 JSON, 不要其他文字。"
    )
    import tempfile
    try:
        with tempfile.TemporaryDirectory() as td:
            r = subprocess.run(["dsh", "--profile", "headless", prompt], cwd=td,
                               capture_output=True, text=True, timeout=180)
    except Exception as exc:
        raise KanbanError(f"AI 拆解失败 (dsh headless 调用): {exc}")
    arr = _extract_json_array(r.stdout)
    if not arr:
        raise KanbanError(f"AI 未返回有效的 JSON 拆解:\n{r.stdout[:300]}")
    root = board_root()
    base_slug = _sanitize_slug(module) or "part"
    used = set()
    task_ids = []
    for idx, item in enumerate(arr):
        if not isinstance(item, dict):
            continue
        sub_title = item.get("title") or f"{title} · 子任务{idx + 1}"
        sub_desc = item.get("description") or goal
        sub_acc = item.get("acceptance") or []
        if isinstance(sub_acc, str):
            sub_acc = [sub_acc]
        slug = _sanitize_slug(item.get("slug") or sub_title)
        if slug in ("req", "") or slug in used:
            slug = f"{base_slug}-{idx + 1}"
        while slug in used:
            slug = f"{slug}-{idx + 1}"
        used.add(slug)
        task_id = f"{today()}-{slug}-task"
        if find_card_any(root, task_id)[1] is not None:
            raise KanbanError(f"{task_id} 已存在, 请先处理或重试")
        text = template_card(sub_title, "feature")
        text = text.replace("- 类型: Feature", f"- 类型: Feature\n- 需求类型: {type_label}\n- 模块: {module}")
        text = text.replace("<填写>\n\n## 用户决策", f"{sub_desc}\n\n## 用户决策")
        text = text.replace("## 用户决策\n\nN/A", "## 用户决策\n\n按需求拆解执行 (父需求见 讨论与决策)。")
        text = text.replace("## 预期成果\n\n<填写>", f"## 预期成果\n\n{sub_desc}")
        text = text.replace("- [ ] <填写>", "\n".join(f"- [ ] {a}" for a in sub_acc))
        if fields.get("红线"):
            text = text.replace("## 红线\n\n- <禁止事项: 不可改的模块/数据/环境, 触发即停下报告; 无则 N/A>",
                                f"## 红线\n\n{fields['红线']}")
        text = text.replace("## 不在本轮范围\n\n- <填写>", f"## 不在本轮范围\n\n{scope}")
        text = text.replace("## 讨论与决策\n",
                            f"## 讨论与决策\n\n需求来源: {target} (AI 拆解)\n父需求: {target}\n", 1)
        (root / "backlog" / f"{task_id}.md").write_text(text, encoding="utf-8")
        task_ids.append(task_id)
    req_file = req["path"]
    req_text = req_file.read_text(encoding="utf-8")
    if "拆解:" in req_text:
        req_text = re.sub(r"^- 拆解:.*$", f"- 拆解: {', '.join(task_ids)}", req_text, count=1, flags=re.M)
    else:
        req_text = re.sub(r"^- 优先级:.*$", lambda m: m.group(0) + f"\n- 拆解: {', '.join(task_ids)}",
                          req_text, count=1, flags=re.M)
    req_file.write_text(req_text, encoding="utf-8")
    print(f"AI 拆解 {target} -> {len(task_ids)} 张看板卡 (子任务按语义划分):")
    for tid in task_ids:
        print(f"  - {tid}")
    print("子卡引用父需求; 父需求已记录拆解任务.")
    return 0


def _design_break(args) -> int:
    """kanban design break <REQ-ID|路径> — AI 语义拆解需求为多张看板任务卡 (始终走 AI)."""
    if len(args) != 1:
        raise KanbanError("kanban design break 需要 <REQ-ID> 或需求文件路径")
    target = args[0]
    req_root = _req_root()
    if REQ_ID_RE.match(target):
        m = re.match(r"^REQ-([PAN])-(\d{3})$", target)
        f = req_root / REQ_TYPE_DIRS[REQ_LETTER_TO_TYPE[m.group(1)]] / f"{target}.md"
    else:
        f = Path(target).resolve()
    if not f.is_file():
        raise KanbanError(f"找不到需求文件: {target}")
    reqs = _parse_reqs(f)
    if target in reqs:
        req = reqs[target]
    elif len(reqs) == 1:
        target = list(reqs.keys())[0]
        req = reqs[target]
    else:
        raise KanbanError("无法解析需求")
    return _break_ai(target, req)


def cmd_design(args) -> int:
    """kanban design <init|new|list|show|break> — 需求仓库 (design 阶段, 转 kanban 前)."""
    if not args:
        raise KanbanError("kanban design 需要子命令: init|new|list|show|break")
    sub, rest = args[0], args[1:]
    if sub == "init":
        return _design_init(rest)
    if sub == "new":
        return _design_new(rest)
    if sub == "list":
        return _design_list(rest)
    if sub == "show":
        return _design_show(rest)
    if sub == "break":
        return _design_break(rest)
    raise KanbanError(f"未知 design 子命令: {sub} (可用: init|new|list|show|break)")


def _design_init(args) -> int:
    """kanban design init — 幂等创建需求仓库骨架 + 规范文档.
    旧版目录 tech/、balance/ 与编号 REQ-T/B 自动迁移为 program/、numeric/ 与 REQ-P/N
    (仅当目录为空或文件可安全改名时; 有旧编号需求文件时提示手动处理)."""
    if args:
        raise KanbanError("kanban design init 不带参数")
    req_root = _req_root()
    # 迁移旧版命名 (tech→program, balance→numeric; 目录与 specs)
    _migrate_legacy_names(req_root)
    (req_root / "program").mkdir(parents=True, exist_ok=True)
    (req_root / "art").mkdir(parents=True, exist_ok=True)
    (req_root / "numeric").mkdir(parents=True, exist_ok=True)
    specs = req_root / "specs"
    specs.mkdir(parents=True, exist_ok=True)
    created = 0
    for name, content in (("README.md", REQ_README),
                          ("specs/program.md", REQ_SPEC_PROGRAM),
                          ("specs/art.md", REQ_SPEC_ART),
                          ("specs/numeric.md", REQ_SPEC_NUMERIC)):
        p = req_root / name
        if not p.exists():
            p.write_text(content, encoding="utf-8")
            created += 1
    print(f"需求仓库: {req_root} (program|art|numeric 各一目录, 已建)")
    if created:
        print(f"已生成规范文档: {created} 份 (README.md, specs/program.md, specs/art.md, specs/numeric.md)")
    else:
        print("规范文档已存在, 跳过 (幂等)")
    print("建需求: kanban design new --type program|art|numeric --module <模块> --title <标题> [--pri P0|P1|P2|P3]")
    return 0


def _migrate_legacy_names(req_root: Path) -> None:
    """旧版 tech/balance 命名 → program/numeric (仅迁移骨架与 specs 文件;
    旧编号 REQ-T/B 需求文件不自动改, 提示人工处理)."""
    legacy_dirs = (("tech", "program"), ("balance", "numeric"))
    for old, new in legacy_dirs:
        old_dir = req_root / old
        new_dir = req_root / new
        if old_dir.is_dir() and not new_dir.exists():
            legacy_files = list(old_dir.glob("REQ-*.md"))
            if legacy_files:
                print(f"提示: 旧目录 {old_dir} 含旧编号需求文件 {len(legacy_files)} 个, 未自动迁移; "
                      f"请手动改名为 {new_dir} 下并更新编号 (REQ-{old[0].upper()}→REQ-{new[0].upper()})")
            else:
                old_dir.rename(new_dir)
                print(f"已迁移目录: {old_dir} → {new_dir}")
        elif old_dir.is_dir() and new_dir.exists():
            print(f"提示: {old_dir} 与 {new_dir} 并存; 请手动合并后删除 {old_dir}")
    for old, new in (("tech.md", "program.md"), ("balance.md", "numeric.md")):
        old_f = req_root / "specs" / old
        new_f = req_root / "specs" / new
        if old_f.is_file() and not new_f.exists():
            old_f.rename(new_f)
            print(f"已迁移规范: {old_f} → {new_f}")
        elif old_f.is_file() and new_f.exists():
            print(f"提示: {old_f} 与 {new_f} 并存; 请手动合并后删除 {old_f}")


def _design_new(args) -> int:
    """kanban design new --type program|art|numeric --module <模块> --title <标题> [--pri P0|P1|P2|P3]
    新建需求文件, 编号自动递增; 状态默认「待评审」."""
    rtype = None
    module = None
    title = None
    pri = "P2"
    rest = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--type":
            i += 1
            if i >= len(args):
                raise KanbanError("--type 需要 program|art|numeric")
            rtype = args[i]
        elif a == "--module":
            i += 1
            if i >= len(args):
                raise KanbanError("--module 需要 <模块名>")
            module = args[i]
        elif a == "--title":
            i += 1
            if i >= len(args):
                raise KanbanError("--title 需要 <需求标题>")
            title = args[i]
        elif a == "--pri":
            i += 1
            if i >= len(args):
                raise KanbanError("--pri 需要 P0|P1|P2|P3")
            pri = args[i]
        else:
            raise KanbanError(f"未知选项: {a}")
        i += 1
    if rtype not in REQ_TYPES:
        raise KanbanError(f"--type 必须是 {'/'.join(REQ_TYPES)} (program 程序|art 美术|numeric 数值)")
    if not module:
        raise KanbanError("--module 必填 (模块/游戏名)")
    if not title:
        raise KanbanError("--title 必填 (需求标题)")
    if pri not in ("P0", "P1", "P2", "P3"):
        raise KanbanError("--pri 只能是 P0|P1|P2|P3")
    req_root = _req_root()
    if not (req_root / "specs" / "program.md").exists():
        raise KanbanError(f"需求仓库未初始化: {req_root} (先 kanban design init)")
    req_dir = req_root / REQ_TYPE_DIRS[rtype]
    req_dir.mkdir(parents=True, exist_ok=True)
    num = _req_next_num(req_dir, rtype)
    rid = f"REQ-{rtype[0].upper()}-{num:03d}"
    common = REQ_COMMON_FIELDS.format(rtype=rtype, module=module, pri=pri)
    tmpl = {"program": REQ_TEMPLATE_PROGRAM, "art": REQ_TEMPLATE_ART, "numeric": REQ_TEMPLATE_NUMERIC}[rtype]
    text = tmpl.format(num=num, title=title, common=common)
    f = req_dir / f"{rid}.md"
    f.write_text(text, encoding="utf-8")
    print(f"已创建需求: {f}")
    print(f"  编号: {rid}  ({REQ_TYPE_LABELS[rtype]})  模块: {module}  优先级: {pri}")
    print("  下一步: 填需求描述/验收标准 → 评审 → 状态改「已拍板」→ 转看板:")
    print(f"    kanban new --spec-file {req_root} --req {rid} <feature|bug|chore|research> <slug> <标题>")
    return 0


def _design_list(args) -> int:
    """kanban design list [--type t] [--module m] [--status s] — 需求仓库列表 (含看板映射)."""
    rtype = None
    module = None
    status = None
    rest = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--type":
            i += 1
            if i >= len(args):
                raise KanbanError("--type 需要 program|art|numeric")
            rtype = args[i]
            if rtype not in REQ_TYPES:
                raise KanbanError(f"--type 只能是 {'/'.join(REQ_TYPES)}")
        elif a == "--module":
            i += 1
            if i >= len(args):
                raise KanbanError("--module 需要 <模块名>")
            module = args[i]
        elif a == "--status":
            i += 1
            if i >= len(args):
                raise KanbanError("--status 需要 <状态>")
            status = args[i]
        else:
            rest.append(a)
        i += 1
    if rest:
        raise KanbanError(f"未知参数: {' '.join(rest)}")
    req_root = _req_root()
    if not req_root.is_dir():
        raise KanbanError(f"需求仓库不存在: {req_root} (先 kanban design init)")
    reqs = _parse_reqs(req_root)
    if not reqs:
        print(f"需求仓库为空: {req_root} (kanban design new 建需求)")
        return 0
    root = board_root()
    # 排序: 类型 (program<art<numeric) → 编号 → 状态流转
    def sort_key(kv):
        rid, info = kv
        m = re.match(r"^REQ-([PAN])-(\d{3})$", rid)
        t = m.group(1) if m else "Z"
        n = int(m.group(2)) if m else 0
        f = info["fields"]
        return (t, n, _req_status_rank(f.get("状态", "")))
    shown = 0
    for rid, info in sorted(reqs.items(), key=sort_key):
        f = info["fields"]
        if rtype and f.get("类型") != rtype:
            continue
        if module and module not in f.get("模块", ""):
            continue
        if status and f.get("状态") != status:
            continue
        hit = _find_req_on_board(root, rid)
        line = f"  {rid} {info['title']}  [{REQ_TYPE_LABELS.get(f.get('类型'), '?')}] [{f.get('模块', '-')}] [{f.get('优先级', '-')}] [{f.get('状态', '待评审')}]"
        line += f"  → 看板 {hit[1]} [{hit[0]}]" if hit else "  → 未建卡"
        print(line)
        shown += 1
    if shown == 0:
        print("  (无匹配条目)")
    return 0


def _design_show(args) -> int:
    """kanban design show <REQ-ID|文件路径> — 查看需求文件."""
    if not args:
        raise KanbanError("kanban design show 需要 <REQ-ID> 或文件路径")
    target = args[0]
    req_root = _req_root()
    if REQ_ID_RE.match(target):
        m = re.match(r"^REQ-([PAN])-(\d{3})$", target)
        rtype = REQ_LETTER_TO_TYPE[m.group(1)]
        f = req_root / REQ_TYPE_DIRS[rtype] / f"{target}.md"
        if not f.is_file():
            raise KanbanError(f"找不到需求文件: {target} (在 {req_root}/<type>/ 下)")
    else:
        f = Path(target).resolve()
        if not f.is_file():
            raise KanbanError(f"找不到需求文件: {target}")
    print(read_any_text(f))
    return 0


def cmd_list(args) -> int:
    root = board_root()
    mobile = "--mobile" in args
    rtype = None
    module = None
    rest = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--type":
            i += 1
            if i >= len(args):
                raise KanbanError("--type 需要 program|art|numeric")
            rtype = args[i]
            if rtype not in REQ_TYPES:
                raise KanbanError(f"--type 只能是 {'/'.join(REQ_TYPES)}")
        elif a == "--module":
            i += 1
            if i >= len(args):
                raise KanbanError("--module 需要 <模块名>")
            module = args[i]
        else:
            rest.append(a)
        i += 1
    states = [a for a in rest if a in STATES]
    for state in states or list(STATES):
        state_dir = root / state
        rows = []
        if state_dir.is_dir():
            for entry in sorted(state_dir.iterdir()):
                if entry.is_file() and entry.suffix == ".md":
                    large = False
                    target = entry
                elif entry.is_dir() and (entry / "spec.md").is_file():
                    large = True
                    target = entry / "spec.md"
                else:
                    continue
                text = read_any_text(target)
                if rtype:
                    m = re.search(r"^- 需求类型:\s*(.+)$", text, re.M)
                    if not m or REQ_TYPE_LABELS.get(rtype) != m.group(1).strip():
                        continue
                if module:
                    m = re.search(r"^- 模块:\s*(.+)$", text, re.M)
                    if not m or module not in m.group(1):
                        continue
                m = re.search(r"^- 类型:\s*(.+)$", text, re.M)
                t = m.group(1).strip() if m else "?"
                m = re.search(r"^- (开始时间|完成时间):\s*(.+)$", text, re.M)
                ts = m.group(2).strip() if m else ""
                mark = " [large]" if large else ""
                rows.append((entry_id(entry), card_title(text), t + mark, ts))
        if not rows:
            continue
        print(f"[{state}] ({len(rows)})")
        for task_id, title, t, ts in rows:
            if mobile:
                print(f"  {task_id}  {title} [{t}] {ts}")
            else:
                print(f"  {task_id}  {title}  [{t}] {ts}")
    return 0


def cmd_show(args) -> int:
    if not args:
        raise KanbanError("kanban show 需要 <task-id>")
    root = board_root()
    _, entry = find_card(root, args[0])
    dump_card(entry)
    return 0


# REQ 编号: 旧式全局 REQ-004, 新式分类型 REQ-P-001 (程序) / REQ-A-001 (美术) / REQ-N-001 (数值)
REQ_HEAD_RE = re.compile(r"^#{1,2}\s+(REQ-(?:[PAN]-)?\d+)\s+(.+)$", re.M)
REQ_ID_RE = re.compile(r"^REQ-(?:[PAN]-)?\d+$")
REQ_TYPES = ("program", "art", "numeric")
REQ_TYPE_LABELS = {"program": "程序", "art": "美术", "numeric": "数值"}
REQ_TYPE_DIRS = {"program": "program", "art": "art", "numeric": "numeric"}
REQ_LETTER_TO_TYPE = {"P": "program", "A": "art", "N": "numeric"}


def _parse_reqs(path: Path):
    """解析需求文档/需求仓库 -> {REQ-ID: {title, fields, path}}.
    兼容两种形态:
      - 旧式单文档多条目: `## REQ-004 标题` 起, 到下个 `## ` 为止; 块内 `- 键: 值` 进 fields
      - 新式需求仓库 requirements/: 按类型分目录 (program|art|numeric), 每需求一个文件
        `# REQ-P-001 标题` 起; 头部 `- 键: 值` 进 fields (键: 类型/模块/优先级/状态/
        动机/期望/验收/威胁/范围/关联需求); 章节「需求描述」首段进 期望,
        「验收标准」下 `- ` 行进 验收 (多条以换行拼接).
    path 可以是单个文件或目录; 目录递归收集各类型 REQ-*.md."""
    files = []
    if path.is_dir():
        for sub in path.iterdir():
            if sub.is_dir() and sub.name in REQ_TYPE_DIRS.values():
                files.extend(sorted(sub.glob("REQ-*.md")))
    elif path.is_file():
        files = [path]
    else:
        return {}
    reqs = {}
    for f in files:
        text = read_any_text(f)
        cur = None
        section = None
        desc_lines = []
        accept_lines = []
        scope_lines = []
        redline_lines = []
        for line in text.splitlines():
            m = REQ_HEAD_RE.match(line)
            if m:
                reqs[m.group(1)] = {"title": m.group(2).strip(), "fields": {}, "path": f}
                cur = m.group(1)
                section = None
                desc_lines, accept_lines, scope_lines, redline_lines = [], [], [], []
                continue
            if not cur:
                continue
            sm = re.match(r"^##\s+(.+)$", line)
            if sm:
                section = sm.group(1).strip()
                continue
            fm = re.match(r"^\s*-\s*([^:：]+)[:：]\s*(.+)$", line)
            # 只有头部 (首个 ## 之前) 的 "键: 值" 才是字段; 段落内 (如验收项 "微信登录: xxx")
            # 也是这种形式, 但应作为该章节内容保留, 不能误当字段而丢进验收.
            if fm and section is None:
                reqs[cur]["fields"][fm.group(1).strip()] = fm.group(2).strip()
                continue
            if section == "需求描述":
                s = line.strip()
                if s and not s.startswith("-"):
                    desc_lines.append(s)
            elif section == "验收标准":
                s = line.strip()
                if s.startswith("-"):
                    accept_lines.append(re.sub(r"^-\s*(\[[ xX]\]\s*)?", "", s))
            elif section == "不在本轮范围":
                s = line.strip()
                if s.startswith("-"):
                    scope_lines.append(re.sub(r"^-\s*", "- ", s))
            elif section == "红线":
                s = line.strip()
                if s.startswith("-"):
                    redline_lines.append(re.sub(r"^-\s*", "- ", s))
        flds = reqs[cur]["fields"]
        if desc_lines and not flds.get("期望"):
            flds["期望"] = " ".join(desc_lines)
        if accept_lines:
            flds["验收"] = "\n".join(a for a in accept_lines if a)
        if scope_lines:
            flds["范围"] = "\n".join(scope_lines)
        if redline_lines:
            flds["红线"] = "\n".join(redline_lines)
    return reqs


def _find_req_on_board(root: Path, req_id: str):
    """返回 (state, task_id) 若该需求已映射到某张卡, 否则 None.
    只认卡片「讨论与决策」里的「需求来源: REQ-xxx」权威标记 (kanban new --spec-file 写入),
    不再整卡子串匹配, 避免正文交叉引用 (如 "见 REQ-P-003") 被误判为"已建卡"."""
    for state, entry in iter_entries(root):
        text = read_card(entry)
        if re.search(rf"^\s*需求来源:\s*{re.escape(req_id)}\s", text, re.M):
            return state, entry_id(entry)
    return None


def _priority_key(info) -> tuple:
    p = info["fields"].get("优先级", "").upper()
    rank = {"P0": 0, "P1": 1, "P2": 2, "P3": 3}.get(p, 9)
    return rank, info["title"]


def cmd_req_status(args) -> int:
    """kanban req-status [需求仓库|需求文档] [--type program|art|numeric] [--module <名>]
    — 核对需求条目与看板卡状态 (按优先级排序).
    默认扫描项目根 requirements/ 需求仓库; 也可显式指定单个需求文件/旧式单文档."""
    rtype = None
    module = None
    rest = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--type":
            i += 1
            if i >= len(args):
                raise KanbanError("--type 需要 program|art|numeric")
            rtype = args[i]
            if rtype not in REQ_TYPES:
                raise KanbanError(f"--type 只能是 {'/'.join(REQ_TYPES)}")
        elif a == "--module":
            i += 1
            if i >= len(args):
                raise KanbanError("--module 需要 <模块名>")
            module = args[i]
        else:
            rest.append(a)
        i += 1
    project = board_root().parent
    if rest:
        doc = Path(rest[0])
        if not doc.exists():
            raise KanbanError(f"需求文档不存在: {doc} (可用 kanban req-status <路径>)")
    else:
        doc = project / "requirements"
        if not doc.is_dir():
            raise KanbanError(f"需求仓库不存在: {doc} (先 kanban design init)")
    reqs = _parse_reqs(doc)
    if not reqs:
        if doc.is_dir():
            print(f"{doc}: 需求仓库为空 (kanban design new --type program|art|numeric 建需求)")
        else:
            print(f"{doc}: 未找到 REQ 条目 (格式: ## REQ-004 标题 或 需求仓库 REQ-P/A/N-NNN 文件)")
        return 0
    root = board_root()
    shown = 0
    print(f"需求来源: {doc}" + (" (目录)" if doc.is_dir() else ""))
    for rid, info in sorted(reqs.items(), key=lambda kv: _priority_key(kv[1])):
        f = info["fields"]
        if rtype and f.get("类型") != rtype:
            continue
        if module and module not in f.get("模块", ""):
            continue
        pri = f.get("优先级") or "-"
        mod = f.get("模块") or "-"
        st = f.get("状态") or "-"
        hit = _find_req_on_board(root, rid)
        if hit:
            state, tid = hit
            print(f"  [{pri:>2}] {rid} {info['title']}  [模块:{mod}] [{st}]  → 看板 {tid} [{state}]")
        else:
            print(f"  [{pri:>2}] {rid} {info['title']}  [模块:{mod}] [{st}]  → 未建卡")
        shown += 1
    if shown == 0:
        print("  (无匹配条目)")
    return 0


def cmd_e2e(args) -> int:
    """kanban e2e <task-id> — L3 浏览器 E2E (独立阶段, 任务完成后单独执行).
    不在任务卡验收条件内; 建截图目录 + 打印执行指引, 实际浏览器 E2E 由 Agent
    按技能执行 (起服务 → 走关键流程 → 截图 → 记录到卡片「实施与验证」)."""
    if not args:
        raise KanbanError("kanban e2e 需要 <task-id>")
    root = board_root()
    state, entry = find_card(root, args[0])
    shots = root.parent / "screenshots" / args[0]
    shots.mkdir(parents=True, exist_ok=True)
    print(f"L3 浏览器 E2E: {args[0]} [{state}]")
    print(f"截图目录: {shots}")
    print("执行指引 (Agent 按 onevoke 技能「前端任务验证」执行):")
    print("  1. 启动应用 (如 go run ./cmd/server), 确认端口可访问")
    print("  2. 走关键流程 (登录/验证码/交互)")
    print("  3. 截图存到上面的目录 (命名: 01-login.png ...)")
    print("     优先用 DSH browser 工具: browser_screenshot <url> <截图路径>")
    print("  4. 在卡片「实施与验证」追加记录: 流程/截图路径/结论")
    return 0


def cmd_visual(args) -> int:
    """kanban visual <task-id> — L4 视觉回归 (基线截图 diff).
    首次运行建 baseline/ 存基线截图; 之后截图放 current/, 与 baseline/ 同名文件对比.
    diff 工具自动检测: ImageMagick compare → python3+PIL → 字节哈希兜底."""
    if not args:
        raise KanbanError("kanban visual 需要 <task-id>")
    root = board_root()
    state, entry = find_card(root, args[0])
    vdir = root.parent / "screenshots" / args[0] / "visual"
    baseline = vdir / "baseline"
    current = vdir / "current"
    baseline.mkdir(parents=True, exist_ok=True)
    current.mkdir(parents=True, exist_ok=True)
    print(f"L4 视觉回归: {args[0]} [{state}]")
    print(f"基线目录: {baseline}  (首次运行: 把通过验收的截图存这里, 命名 01-xxx.png 起)")
    print(f"对比目录: {current}  (每次回归: 同命名截图放这里, 自动与基线 diff)")
    base_files = sorted(baseline.glob("*.png"))
    cur_files = sorted(current.glob("*.png"))
    if not base_files:
        print("基线为空: 先把通过验收的截图复制到 baseline/ (命名与 current 对应), 下次运行自动对比。")
        return 0
    if not cur_files:
        print("对比为空: 用 browser 工具/Playwright 截图存 current/ (命名与 baseline 同名), 再跑本命令对比。")
        return 0
    tool = _detect_diff_tool()
    if tool is None:
        print("未检测到像素 diff 工具 (ImageMagick compare / python3+PIL), 用字节哈希对比 (仅判同/异, 无差异量):")
        tool = "hash"
    changed, total = 0, 0
    for bf in base_files:
        cf = current / bf.name
        if not cf.is_file():
            print(f"  {bf.name}: 基线有但 current 缺 (漏截图?)")
            continue
        total += 1
        if tool == "compare":
            r = _diff_imagemagick(bf, cf)
            if r is None:
                print(f"  {bf.name}: compare 失败, 请人工确认")
            elif r == 0:
                print(f"  {bf.name}: 一致 (无差异像素)")
            else:
                print(f"  {bf.name}: 有差异 ({r} 像素)")
                changed += 1
        elif tool == "pil":
            r = _diff_pil(bf, cf)
            if r is None:
                print(f"  {bf.name}: PIL 对比失败 (尺寸不同或非 PNG), 请人工确认")
            elif r == 0:
                print(f"  {bf.name}: 一致 (无差异像素)")
            else:
                print(f"  {bf.name}: 有差异 ({r} 像素)")
                changed += 1
        else:
            same = _diff_hash(bf, cf)
            if same:
                print(f"  {bf.name}: 一致 (字节相同)")
            else:
                print(f"  {bf.name}: 有差异 (字节不同)")
                changed += 1
    print(f"汇总: {total} 张对比, {changed} 张有差异" + (" (0 差异即视觉回归通过)" if changed == 0 else " (差异截图需人/视觉模型确认是否可接受)"))
    return 0


def _detect_diff_tool():
    """返回可用 diff 工具: compare (ImageMagick) | pil | hash (字节兜底)."""
    try:
        r = subprocess.run(["compare", "-version"], capture_output=True, text=True,
                           check=False, timeout=10)
        if r.returncode == 0:
            return "compare"
    except Exception:
        pass
    try:
        r = subprocess.run([sys.executable, "-c", "import PIL"], capture_output=True,
                           text=True, check=False, timeout=10)
        if r.returncode == 0:
            return "pil"
    except Exception:
        pass
    return None


def _diff_imagemagick(a: Path, b: Path):
    """ImageMagick compare: 返回差异像素数 (AE metric), 失败返回 None."""
    try:
        r = subprocess.run(
            ["compare", "-metric", "AE", str(a), str(b), "null:"],
            capture_output=True, text=True, check=False, timeout=30,
        )
        out = (r.stdout + r.stderr).strip()
        m = re.search(r"(\d+)", out)
        return int(m.group(1)) if m else None
    except Exception:
        return None


def _diff_pil(a: Path, b: Path):
    """python3+PIL: 像素级差异计数 (尺寸不同输出 SIZE_DIFF)."""
    script = (
        "import sys; from PIL import Image, ImageChops; "
        "a=Image.open(sys.argv[1]).convert('RGB'); "
        "b=Image.open(sys.argv[2]).convert('RGB'); "
        "print('SIZE_DIFF') if a.size!=b.size else "
        "print(sum(1 for p in ImageChops.difference(a,b).getdata() if p!=(0,0,0)))"
    )
    try:
        r = subprocess.run([sys.executable, "-c", script, str(a), str(b)],
                           capture_output=True, text=True, check=False, timeout=60)
        out = (r.stdout + r.stderr).strip()
        if "SIZE_DIFF" in out:
            return None
        m = re.search(r"(\d+)", out)
        return int(m.group(1)) if m else None
    except Exception:
        return None


def _diff_hash(a: Path, b: Path):
    """字节哈希对比 (无像素工具兜底): 只判同/异."""
    try:
        return a.read_bytes() == b.read_bytes()
    except Exception:
        return None


def cmd_new(args) -> int:
    large = "--large" in args
    frontend = "--frontend" in args
    gid = None
    deps = []
    review = "standard"  # 审核等级: light | standard | full (默认标准)
    spec_file = None
    req_id = None
    rest = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--group":
            i += 1
            if i >= len(args):
                raise KanbanError("--group 需要 <group-id>")
            gid = args[i]
        elif a == "--deps":
            i += 1
            if i >= len(args):
                raise KanbanError("--deps 需要 <task-id,...>")
            deps = [d.strip() for d in re.split(r"[,，]", args[i]) if d.strip()]
        elif a == "--review":
            i += 1
            if i >= len(args):
                raise KanbanError("--review 需要 light|standard|full")
            review = args[i]
            if review not in ("light", "standard", "full"):
                raise KanbanError("--review 只能是 light|standard|full (轻量|标准|完整)")
        elif a == "--spec-file":
            i += 1
            if i >= len(args):
                raise KanbanError("--spec-file 需要 <需求文档路径>")
            spec_file = Path(args[i])
        elif a == "--req":
            i += 1
            if i >= len(args):
                raise KanbanError("--req 需要 <REQ-ID>")
            req_id = args[i]
        elif a == "--large":
            pass  # 已由 large = "--large" in args 处理
        elif a == "--frontend":
            pass  # 已由 frontend = "--frontend" in args 处理
        elif a.startswith("--"):
            raise KanbanError(f"未知选项: {a}")
        else:
            rest.append(a)
        i += 1
    if len(rest) < 3:
        raise KanbanError("kanban new 需要: <feature|bug|chore|research> <slug> <标题...>")
    kind, slug, title = rest[0], rest[1], " ".join(rest[2:])
    if kind not in TYPES:
        raise KanbanError(f"类型必须为 {'/'.join(TYPES)}")
    if not SLUG_RE.match(slug):
        raise KanbanError("slug 只含小写字母/数字/连字符")
    task_id = f"{today()}-{slug}-task"
    if gid:
        if not GROUP_ID_RE.match(gid):
            raise KanbanError(f"任务组 ID 格式错误: {gid} (应形如 {today()}-short-slug-group)")
        for d in deps:
            if not TASK_ID_RE.match(d):
                raise KanbanError(f"前置任务 ID 格式错误: {d}")
    root = board_root()
    ensure_board(root)
    for _, entry in iter_entries(root):
        if entry_id(entry) == task_id:
            raise KanbanError(f"任务 ID 已存在: {task_id}")
    text = template_card(title, kind)
    if frontend:
        # 前端任务验收清单: 只含 L0/L1/L2 (执行 Agent 任务内完成);
        # L3 (浏览器 E2E + 截图) 是独立阶段, 由 kanban e2e <task-id> 单独执行, 不进卡.
        text = text.replace(
            "## 验收条件\n\n- [ ] <填写>",
            "## 验收条件 (前端 L0-L2)\n\n"
            "- [ ] L0 静态断言: 关键元素存在、文案/结构正确\n"
            "- [ ] L1 交互: 点击/输入等行为符合预期 (逻辑测试或浏览器实测)\n"
            "- [ ] L2 接口: 页面调用的后端接口行为正确 (curl/实测)\n",
            1,
        )
        text = text.replace("## 讨论与决策\n", "## 讨论与决策\n\nL3 浏览器 E2E: 独立阶段, 用 kanban e2e 执行(不在本任务内);L4 视觉回归用 kanban visual。\n", 1)
    if spec_file:
        if not spec_file.exists():
            raise KanbanError(f"需求文档不存在: {spec_file}")
        reqs = _parse_reqs(spec_file)
        if not req_id:
            avail = ", ".join(reqs) if reqs else "(无 REQ 条目)"
            raise KanbanError(f"--spec-file 需要配合 --req 指定条目; 可用: {avail}")
        if req_id not in reqs:
            raise KanbanError(f"来源 {spec_file} 没有 {req_id}")
        dup = _find_req_on_board(root, req_id)
        if dup:
            state, tid = dup
            if state == "done":
                raise KanbanError(
                    f"{req_id} 已实现并 done ({tid}); 请勿重复建卡。"
                    f"若确需重做, 先在需求仓库更新后换新编号。"
                )
            raise KanbanError(f"{req_id} 已有进行中卡 ({tid} @ {state}); 如需重开请先处理该卡")
        f = reqs[req_id]["fields"]
        goal = f.get("期望") or f.get("动机") or f.get("目标") or "<填写>"
        accept = f.get("验收") or "<填写>"
        threat = f.get("威胁") or "N/A"
        scope = f.get("范围") or f"- 详见需求来源 {req_id}"
        text = text.replace("<填写>\n\n## 用户决策", f"{goal}\n\n## 用户决策")
        # 预期成果: 需求有显式「预期成果」字段则用它, 否则回退需求描述(期望), 避免 pick 契约校验失败
        expected = f.get("预期成果") or goal
        text = text.replace("## 预期成果\n\n<填写>", f"## 预期成果\n\n{expected}")
        text = text.replace("## 用户决策\n\nN/A", "## 用户决策\n\n按需求文档执行 (需求来源见 讨论与决策)。")
        if accept != "<填写>":
            checks = "\n".join(f"- [ ] {a.strip()}" for a in accept.splitlines() if a.strip())
            text = text.replace("- [ ] <填写>", checks)
        text = text.replace("## 威胁模型\n\nN/A", f"## 威胁模型\n\n{threat}")
        # 范围写入「不在本轮范围」章节 (注意卡片含「红线」章节, 用章节标题定位)
        text = text.replace("## 不在本轮范围\n\n- <填写>", f"## 不在本轮范围\n\n{scope}")
        # 需求红线 (需求文件的「红线」章节或头部字段) → 卡片「红线」
        req_redline = f.get("红线")
        if req_redline:
            text = text.replace("## 红线\n\n- <禁止事项: 不可改的模块/数据/环境, 触发即停下报告; 无则 N/A>",
                                f"## 红线\n\n{req_redline}")
        # 需求类型/模块: 写入卡片头部 (需求仓库分类型需求; 旧式单文档无则跳过)
        req_type = f.get("类型")
        if req_type in REQ_TYPES:
            text = text.replace("- 创建时间: ", f"- 需求类型: {REQ_TYPE_LABELS[req_type]}\n- 创建时间: ", 1)
        req_module = f.get("模块")
        if req_module:
            text = text.replace("- 创建时间: ", f"- 模块: {req_module}\n- 创建时间: ", 1)
        src_disp = str(reqs[req_id].get("path") or spec_file)
        text = text.replace(
            "## 讨论与决策\n",
            f"## 讨论与决策\n\n需求来源: {req_id} {reqs[req_id]['title']} ({src_disp})\n", 1,
        )
        print(f"已从需求来源导入: {req_id} {reqs[req_id]['title']}")
    review_label = {"light": "轻量", "standard": "标准", "full": "完整"}[review]
    text = text.replace("- 审核: 标准", f"- 审核: {review_label}", 1)
    if gid:
        text = stamp_group(text, gid, deps)
    if large:
        target = root / "backlog" / task_id
        target.mkdir()
        (target / "spec.md").write_text(text, encoding="utf-8")
        print(f"已创建大任务: {target}/ (spec.md 已生成; 按需建 plan.md)")
    else:
        target = root / "backlog" / f"{task_id}.md"
        target.write_text(text, encoding="utf-8")
        print(f"已创建: {target}")
    if gid:
        print(f"任务组: {gid}  前置任务: {'N/A' if not deps else ', '.join(deps)}")
    print("立即用已确认内容填完整张卡 (不留 <填写>), 再 kanban pick。")
    return 0


def cmd_upgrade(args) -> int:
    if not args:
        raise KanbanError("kanban upgrade 需要 <task-id>")
    root = board_root()
    state, entry = find_card(root, args[0])
    if is_large(entry):
        print(f"{args[0]} 已是大任务")
        return 0
    if state not in ("backlog", "working"):
        raise KanbanError(f"只有 backlog 或 working 中的小任务可以升级 (当前 {state})")
    text = read_card(entry)
    target = root / state / args[0]
    if target.exists():
        raise KanbanError(f"目标已存在: {target}")
    target.mkdir()
    (target / "spec.md").write_text(text, encoding="utf-8")
    entry.unlink()
    print(f"{args[0]}: 小任务 -> 大任务 (原内容已转入 spec.md, 原文件已删除)")
    print("按需创建 plan.md; 完成时创建 report.md。")
    return 0


def cmd_pick(args) -> int:
    root = board_root()
    if not args:
        candidates = [entry_id(e) for s, e in iter_entries(root) if s == "backlog"]
        if not candidates:
            print("backlog 没有候选卡")
            return 0
        print("候选 (backlog):")
        for c in sorted(candidates):
            print(f"  {c}")
        return 0
    state, entry = find_card(root, args[0])
    if state != "backlog":
        raise KanbanError(f"{args[0]} 不在 backlog (当前 {state})")
    text = read_card(entry)
    problems = validate_contract(text, args[0])
    if problems:
        raise KanbanError("契约不完整:\n  " + "\n  ".join(problems))
    os.rename(entry, root / "todo" / entry.name)
    print(f"{args[0]} -> todo (契约已校验)")
    return 0


def resolve_dsh() -> list:
    exe = shutil.which("dsh")
    if exe:
        return [exe]
    npx = shutil.which("npx")
    if npx:
        return [npx, "--yes", "dsh"]
    return []


def task_prompt(task_id: str, title: str, entry: Path) -> str:
    board = entry.parent.parent
    project = board.parent
    rules = board / "RULES.md"
    mem = board / "MEMORY.md"
    arch = project / "requirements" / "specs" / "program.md"
    notes = []
    if rules.exists():
        notes.append(f" 若 {rules} 存在, 先读它(项目看板规则, 优先级高于通用技能)。")
    if mem.exists():
        notes.append(f" 若 {mem} 存在, 先读它(跨任务记忆, 参考以往经验与决策)。")
    if arch.exists():
        notes.append(f" 若 {arch} 存在, 先读它「技术架构」章节 (选型/模块/边界/数据流; 实现应遵循其设计, 有出入先说明再偏离)。")
    return (
        f"看板任务 {task_id} - {title}。"
        f"先加载 onevoke 技能并遵循它; 再读卡片 {entry}; 再读项目 AGENTS.md/规则。"
        f"然后按技能流程实现该任务 (worktree + 分支 + 提交 + 审核 + 请求验收)。"
        f"本任务在独立会话中执行; 会话恢复 id 见 TUI 退出提示, 结束时把它记入卡片"
        f"「讨论与决策」(格式: 会话: <id>)。"
        + "".join(notes)
    )


REVIEW_LEVELS = {"轻量": "light", "标准": "standard", "完整": "full",
                 "light": "light", "standard": "standard", "full": "full"}


def review_level(text: str) -> str:
    """读卡片 `- 审核:` 元数据, 返回 light|standard|full (默认 standard)."""
    m = re.search(r"^- 审核:\s*(轻量|标准|完整|light|standard|full)\s*$", text, re.M)
    if m:
        return REVIEW_LEVELS[m.group(1)]
    return "standard"


def cmd_resume(args) -> int:
    """kanban resume [--all | <task-id> ...] — 恢复卡片记录的会话 (崩溃/中断后续跑).
    --all: 恢复全部 working 卡 (未在运行的会话); 默认等价 --all (无参数时)."""
    all_flag = "--all" in args
    ids = [a for a in args if a != "--all"]
    root = board_root()
    if all_flag or not ids:
        # 无参数或 --all: 收集所有 working 卡
        ids = [entry_id(e) for s, e in iter_entries(root) if s == "working"]
    if not ids:
        print("没有可恢复的任务 (working 为空或未指定 task-id)")
        return 0
    restored, skipped = 0, 0
    for tid in ids:
        try:
            state, entry = find_card(root, tid)
        except KanbanError as exc:
            print(f"跳过 {tid}: {exc}")
            skipped += 1
            continue
        text = read_card(entry)
        m = re.search(r"^会话:\s*(\S+)", section_body(text, "讨论与决策"), re.M)
        if not m:
            print(f"跳过 {tid}: 卡片没有会话记录 (可能是手动启动的任务)")
            skipped += 1
            continue
        session_id = m.group(1).strip()
        if _session_running(session_id):
            print(f"跳过 {tid}: 会话已在运行 ({session_id})")
            skipped += 1
            continue
        dsh = resolve_dsh()
        if not dsh:
            print(f"未找到 dsh CLI。手动恢复:")
            print(f"  dsh --profile tui --resume={session_id}")
            skipped += 1
            continue
        launch_cmd = f"{' '.join(dsh)} --profile tui --resume={session_id}"
        host = _tmux_host_session()
        if host:
            win = f"kb-{entry_id(entry).split('-', 1)[1].rsplit('-task', 1)[0]}-r"
            shell_cmd = f"bash -lc '{launch_cmd}; echo; echo [会话已退出, 窗口保持打开]; exec bash'"
            r = subprocess.run(
                ["tmux", "new-window", "-t", host, "-d", "-n", win, shell_cmd],
                capture_output=True, text=True, check=False, timeout=15,
            )
            if r.returncode == 0:
                print(f"已在 tmux window [{win}] 恢复会话: {session_id}")
                restored += 1
                continue
        print(f"请在新终端恢复任务会话:")
        print(f"  {launch_cmd}")
        print("然后粘贴: 继续按 onevoke 技能完成剩余步骤 (检查状态后继续)。")
        skipped += 1
    print(f"resume 完成: 恢复 {restored}, 跳过 {skipped}")
    return 0


def check_deps(root: Path, text: str, task_id: str) -> list:
    """返回未满足的前置任务列表 (全 done 才算满足)."""
    gid, deps = group_fields(text)
    if not deps:
        return []
    missing = []
    for d in deps:
        st, _ = find_card_any(root, d)
        if st != "done":
            missing.append(f"{d} (当前 {st or '不存在'})")
    return missing


def _check_concurrency(root: Path, cfg: dict) -> None:
    """最大同时任务数: .dsh-onevoke.yml limits.max_concurrent_tasks (0=不限),
    环境变量 KANBAN_MAX_CONCURRENT_TASKS 覆盖. 达到上限时拒绝新 start."""
    limit = int(os.environ.get("KANBAN_MAX_CONCURRENT_TASKS",
                                (cfg.get("limits") or {}).get("max_concurrent_tasks", 0) or 0))
    if limit <= 0:
        return
    # 统计 working 卡数
    working = 0
    wdir = root / "working"
    if wdir.is_dir():
        for entry in wdir.iterdir():
            if entry.is_file() and entry.suffix == ".md":
                working += 1
            elif entry.is_dir() and (entry / "spec.md").is_file():
                working += 1
    if working >= limit:
        raise KanbanError(
            f"已达到并发上限: working 中有 {working} 张卡, max_concurrent_tasks={limit} "
            f"(0 关闭限制; 环境变量 KANBAN_MAX_CONCURRENT_TASKS 覆盖配置); "
            f"先完成或归档部分任务再启动。"
        )


def _tmux_session() -> str:
    out = subprocess.run(
        ["tmux", "display-message", "-p", "#S"],
        capture_output=True, text=True, check=False, timeout=10,
    )
    return out.stdout.strip() if out.returncode == 0 else ""


def _tmux_host_session() -> str:
    """返回可建任务窗口的目标 tmux 会话名, 无则新建并返回其名.
    优先级: 当前 TMUX 会话 > 项目目录名会话 (如 task-vault) > 新建同名会话.
    让 resume/auto 在非 tmux 环境 (如 WSL 普通 bash) 也能把任务窗口开进管理会话."""
    if shutil.which("tmux") is None:
        return ""
    cur = os.environ.get("TMUX", "")
    if cur:
        out = subprocess.run(
            ["tmux", "display-message", "-p", "#S"],
            capture_output=True, text=True, check=False, timeout=10,
        )
        if out.returncode == 0 and out.stdout.strip():
            return out.stdout.strip()
    try:
        name = re.sub(r"[^A-Za-z0-9_.-]+", "-", board_root().parent.name) or "dsh-session"
    except Exception:
        name = "dsh-session"
    r = subprocess.run(["tmux", "has-session", "-t", name],
                       capture_output=True, check=False, timeout=10)
    if r.returncode == 0:
        return name
    r = subprocess.run(["tmux", "new-session", "-d", "-s", name],
                       capture_output=True, text=True, check=False, timeout=15)
    return name if r.returncode == 0 else ""


def _session_running(session_id: str) -> bool:
    """kb-<task-id> 会话是否有 dsh TUI 进程在跑 (跨 tmux 窗口, 冷启动检测用)."""
    if not session_id:
        return False
    try:
        out = subprocess.run(["ps", "-eo", "args="],
                             capture_output=True, text=True, check=False, timeout=10)
        for line in out.stdout.splitlines():
            if session_id in line and ("--resume" in line or "--profile" in line):
                return True
    except Exception:
        pass
    return False


def _tmux_window_index(win: str):
    """在当前 tmux 会话里按窗口名找索引 (裸窗口名不能直接做 target)."""
    out = subprocess.run(
        ["tmux", "list-windows", "-F", "#{window_index} #{window_name}"],
        capture_output=True, text=True, check=False, timeout=10,
    )
    if out.returncode != 0:
        return None
    for line in out.stdout.splitlines():
        parts = line.split(" ", 1)
        if len(parts) == 2 and parts[1] == win:
            return parts[0]
    return None


def _find_project_config() -> Path:
    """项目配置固定在看板目录内: kanban/.dsh-onevoke.yml (跟随看板, 本地).
    不做项目根查找 — 配置归属看板, 一个位置更清晰."""
    try:
        f = board_root() / ".dsh-onevoke.yml"
        return f if f.is_file() else None
    except Exception:
        return None


def _parse_project_config():
    """解析 .dsh-onevoke.yml (轻量 YAML, 三层):
      model:     执行模型  {provider, model}
      plan:      规划模型  {provider, model}  (需求分析/填卡的主会话建议模型)
      review:    审核通用  {provider, model}
      reviewers: 审核按角色 {PM/QA/CSA/Hacker: {provider, model}}
    返回 dict; 缺省键不存在."""
    f = _find_project_config()
    if f is None:
        return {}
    try:
        text = f.read_text(encoding="utf-8")
    except OSError:
        return {}
    cfg = {}
    section = None      # 顶层: model / plan / review / reviewers / ...
    subsection = None   # reviewers 下的角色
    for line in text.splitlines():
        if line.strip() == "" or line.strip().startswith("#"):
            continue
        indent = len(line) - len(line.lstrip())
        m = re.match(r"([A-Za-z_]+):\s*(.*)$", line.strip())
        if m is None:
            continue
        val_raw = m.group(2).split("#", 1)[0]  # 去掉行内注释 (如 "2 # 最大同时任务数..."), 否则 int() 解析崩溃
        key, val = m.group(1), val_raw.strip().strip("\"'")
        if indent == 0:
            section = key
            subsection = None
            continue
        if section == "reviewers" and indent == 2:
            subsection = key  # 角色段
            continue
        if section == "reviewers" and indent >= 4 and subsection:
            cfg.setdefault("reviewers", {}).setdefault(subsection, {})[key] = val
            continue
        if indent == 2 and section in ("model", "plan", "review", "permission", "executor", "limits"):
            cfg.setdefault(section, {})[key] = val
    return cfg


def _load_project_model():
    """兼容旧调用: 从项目配置取执行模型 (provider, model) 或 None."""
    cfg = _parse_project_config()
    m = cfg.get("model")
    if m and m.get("provider") and m.get("model"):
        return m["provider"], m["model"]
    return None


def _ensure_session(session_id: str, cwd: str) -> bool:
    """按官方格式预建 DSH 会话 (kb-<task-id>), 让 --resume 可用. 失败返回 False."""
    node = shutil.which("node")
    helper = Path(__file__).resolve().parent / "create-session.mjs"
    if not node or not helper.exists():
        return False
    try:
        r = subprocess.run(
            [node, str(helper), session_id, cwd],
            capture_output=True, text=True, check=False, timeout=30,
        )
        return r.returncode == 0
    except Exception:
        return False


def cmd_start(args) -> int:
    no_window = "--no-window" in args
    ignore_deps = "--ignore-deps" in args
    # 执行器: 命令行 --agent 覆盖配置 executor, 默认 dsh (DSH 会话) | claude|codex (外部 CLI, tmux 窗口里跑)
    cfg = _parse_project_config()
    agent = (cfg.get("executor") or {}).get("agent", "dsh")
    rest = []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--agent":
            i += 1
            if i >= len(args):
                raise KanbanError("--agent 需要 dsh|claude|codex")
            agent = args[i]
        else:
            rest.append(a)
        i += 1
    if agent not in ("dsh", "claude", "codex"):
        raise KanbanError("--agent 只能是 dsh|claude|codex (或配置 executor.agent)")
    ids = [a for a in rest if not a.startswith("--")]
    if not ids:
        raise KanbanError("kanban start 需要 <task-id>")
    root = board_root()
    state, entry = find_card(root, ids[0])
    if state != "todo":
        raise KanbanError(f"{ids[0]} 不在 todo (当前 {state}); 先 kanban pick")
    text = read_card(entry)
    problems = validate_contract(text, ids[0])
    if problems:
        raise KanbanError("契约不完整:\n  " + "\n  ".join(problems))
    if not ignore_deps:
        missing = check_deps(root, text, ids[0])
        if missing:
            raise KanbanError(
                f"{ids[0]} 的前置任务未全部完成: " + ", ".join(missing)
                + " (全部进入 done 后才能启动; 用户明确要求可加 --ignore-deps)"
            )
    _check_concurrency(root, cfg)

    owner = os.environ.get("USER") or os.environ.get("USERNAME") or "agent"
    updated = re.sub(r"^- 负责人:.*$", f"- 负责人: {owner}", text, count=1, flags=re.M)
    updated = re.sub(r"^- 开始时间:.*$", f"- 开始时间: {now()}", updated, count=1, flags=re.M)
    write_entry(entry, updated)
    target = root / "working" / entry.name
    os.rename(entry, target)
    print(f"{ids[0]} -> working (负责人: {owner}, 开始时间: {now()})")

    # 拉起新 DSH 会话执行该任务 (任务 = 独立会话, 稳定 id = kb-<task-id>).
    # --resume 只能恢复已存在的会话, 所以先用 create-session.mjs 按官方格式预建
    # 空会话 (已存在则跳过), 再 --resume; 预建失败则回退全新 UUID 会话.
    dsh = resolve_dsh()
    if not dsh:
        print(f"未找到 dsh CLI。手动启动新会话:")
        print("  dsh --profile tui")
        print(f"然后粘贴任务 prompt: {task_prompt(ids[0], card_title(updated), target)}")
        return 0
    session_id = f"kb-{ids[0]}"
    stable = _ensure_session(session_id, str(Path.cwd().resolve()))
    # 稳定 id 记入卡片「讨论与决策」(幂等)
    if stable:
        text2 = read_card(target)
        body = section_body(text2, "讨论与决策")
        if not re.search(r"^会话:\s*\S+", body, re.M):
            text2 = text2.replace(
                "## 讨论与决策\n",
                f"## 讨论与决策\n\n会话: {session_id}\n", 1,
            )
            write_entry(target, text2)
    prompt = task_prompt(ids[0], card_title(updated), target)
    # 项目级配置: .dsh-onevoke.yml (按项目隔离, 可提交 git)
    cfg = _parse_project_config()
    pm = cfg.get("model")
    if pm and pm.get("provider") and pm.get("model"):
        pm_provider, pm_model = pm["provider"], pm["model"]
        pm_effort = pm.get("reasoningEffort")
        effort_note = f", 推理级别 {pm_effort}" if pm_effort else ""
        prompt += f" 本任务执行模型: {pm_provider}/{pm_model}{effort_note} (来自项目 .dsh-onevoke.yml)。"
        if pm_effort:
            prompt += (f" 在 /model 弹窗选中该模型后, 把推理级别调到 {pm_effort} "
                       f"(off|low|high|max; 若该模型不支持则保持默认)。")
    else:
        pm = None
    plan_cfg = cfg.get("plan")
    # 审核等级 (卡 `- 审核:` 字段, kanban new --review 设定)
    rlevel = review_level(updated)
    rlabel = {"light": "轻量", "standard": "标准", "full": "完整"}[rlevel]
    prompt += (f" 本任务审核等级: {rlabel} ({rlevel})。"
               f"轻量=只跑 PM 或自审并记录, 跳过 QA/CSA/Hacker; "
               f"标准=PM → QA, CSA/Hacker 按触发条件; 完整=PM → CSA/Hacker → QA 全跑。")
    # 任务会话沙箱: 默认 danger-full-access (Onevoke 同款免确认), 项目可覆盖
    perm = (cfg.get("permission") or {}).get("mode", "danger-full-access")
    if perm not in ("read-only", "workspace-write", "danger-full-access"):
        perm = "danger-full-access"

    # ── 外部 CLI 执行 (--agent claude|codex): 自动开 tmux 窗口跑对应 CLI, QuickTUI 可见 ──
    if agent != "dsh":
        bin_ = shutil.which(agent)
        if not bin_:
            raise KanbanError(f"未找到 {agent} CLI; 请先安装并加入 PATH (或改用默认 dsh 执行器)")
        # 原版 onevoke 同款命令模板: claude -p / codex exec, 读 ~/.agents 规则 (install.sh 已装)
        if agent == "claude":
            agent_cmd = [bin_, "-p", prompt]
            desc = "Claude CLI"
        else:  # codex
            agent_cmd = [bin_, "exec", "--skip-git-repo-check", prompt]
            desc = "Codex CLI"
        env_load = ("export PATH=\"$HOME/.local/bin:$HOME/.dsh/bin:$PATH\"; "
                    "[ -f \"$HOME/.profile\" ] && . \"$HOME/.profile\" 2>/dev/null || true")
        quoted = " ".join(shlex.quote(p) for p in agent_cmd)
        if no_window or not (os.environ.get("TMUX") and shutil.which("tmux")):
            print(f"请在新终端启动任务会话 ({desc}):")
            print(f"  {quoted}")
            print("提示: 在 tmux 里跑则 QuickTUI 可见; 用 kanban web 看状态。")
            return 0
        slug = ids[0].split("-", 1)[1].rsplit("-task", 1)[0]
        win = f"kb-{slug}"
        # 不包 bash -lc '...' (prompt 里可能含单引号, 会破坏外层单引号导致语法错误窗口秒退);
        # 直接把命令字符串交给 tmux 执行 (原版 onevoke 同款), tmux 自己用 shell 跑.
        shell_cmd = (f"{env_load}; cd {shlex.quote(str(Path.cwd().resolve()))}; "
                     f"{quoted}; echo; echo [任务会话已退出, 窗口保留]; exec bash")
        r = subprocess.run(
            ["tmux", "new-window", "-d", "-n", win, shell_cmd],
            capture_output=True, text=True, check=False, timeout=15,
        )
        if r.returncode != 0:
            print(f"tmux 启动失败 ({r.stderr.strip() or r.stdout.strip()}); 请手动运行:")
            print(f"  {quoted}")
            return 0
        print(f"已在 tmux window [{win}] 启动 {desc} 任务会话, prompt 已内嵌")
        print("QuickTUI attach 当前会话即可查看 (任务进程在 tmux 窗口里)。")
        return 0

    env_prefix = f"DSH_PERMISSION_MODE={perm} "
    launch = [*dsh, "--profile", "tui"] + ([f"--resume={session_id}"] if stable else [])
    launch_cmd = env_prefix + " ".join(launch)
    if no_window or not (os.environ.get("TMUX") and shutil.which("tmux")):
        print(f"请在新终端启动任务会话:")
        print(f"  {launch_cmd}")
        if pm:
            effort_hint = f" (推理级别 {pm.get('reasoningEffort')})" if pm.get("reasoningEffort") else ""
            print(f"项目执行模型: 先执行 /model {pm_provider}/{pm_model}{effort_hint} 再粘贴任务 prompt")
        print("然后粘贴:")
        print(f"  {prompt}")
        if plan_cfg and plan_cfg.get("provider") and plan_cfg.get("model"):
            plan_effort = plan_cfg.get("reasoningEffort")
            effort_hint = f", 推理级别 {plan_effort}" if plan_effort else ""
            print(f"规划模型: {plan_cfg['provider']}/{plan_cfg['model']}{effort_hint} (下一个需求的分析/填卡阶段请在主会话用 /model 切换)")
        if stable:
            print(f"会话 id 稳定: {session_id} (恢复: dsh --profile tui --resume={session_id})")
        else:
            print("恢复: TUI 内 /resume 按标题选会话, 或按退出提示的 id 用 --resume=<id>")
        return 0

    # tmux 模式: 新建 kb-<slug> window 跑 TUI, 注入任务 prompt.
    # 用 bash -lc 包装: dsh 退出后窗口保持打开 (tmux 默认 remain-on-exit off
    # 会在命令退出时自动关窗, 导致 send-keys 找不到 pane).
    # 环境加载: bash -lc 是 login shell 会读 ~/.profile, 但 ~/.bashrc 常有非交互
    # 早退 (case $- in *i*) ;; *) return) 使其中 export 的 API key 对任务窗口不可见.
    # 这里启动 dsh 前显式 source ~/.profile (无早退), 与 login 加载双保险.
    slug = ids[0].split("-", 1)[1].rsplit("-task", 1)[0]
    win = f"kb-{slug}"
    env_load = "[ -f \"$HOME/.profile\" ] && . \"$HOME/.profile\" 2>/dev/null || true"
    shell_cmd = f"bash -lc '{env_load}; {launch_cmd}; echo; echo [任务会话已退出, 窗口保持打开; 恢复: dsh --profile tui --resume={session_id if stable else '<id>'}]; exec bash'"
    r = subprocess.run(
        ["tmux", "new-window", "-d", "-n", win, shell_cmd],
        capture_output=True, text=True, check=False, timeout=15,
    )
    if r.returncode != 0:
        print(f"tmux 启动失败 ({r.stderr.strip() or r.stdout.strip()}); 请手动运行:")
        print(f"  {launch_cmd}")
        print(f"然后粘贴: {prompt}")
        return 1
    # 用「会话:窗口名」定位 tmux 窗口 (多窗口下索引易错位; tmux 窗口名可直接作 target)
    session = _tmux_session()
    if not session or _tmux_window_index(win) is None:
        print(f"窗口 [{win}] 未创建成功或已退出 (dsh 可能启动失败); 请手动运行:")
        print(f"  {launch_cmd}")
        print(f"然后粘贴: {prompt}")
        return 1
    target = f"{session}:{win}"
    # 等 TUI 就绪 (输入提示 "dsh >" 出现) 再注入, 否则按键会在 TUI 启动阶段丢失; 放宽到最多 ~80s
    ready = False
    for _ in range(40):
        time.sleep(2)
        cap = subprocess.run(
            ["tmux", "capture-pane", "-t", target, "-p"],
            capture_output=True, text=True, check=False, timeout=10,
        )
        if cap.returncode == 0 and ("dsh >" in cap.stdout or "dsh>" in cap.stdout):
            ready = True
            break
    if not ready:
        print(f"窗口 [{win}] 的 TUI 未在预期时间内就绪, prompt 未注入;")
        print(f"请切到该窗口手动粘贴任务 prompt:")
        print(f"  {prompt}")
        return 0
    if pm:
        # 项目级模型: 先执行 /model 切换会话模型, 再注入任务 prompt
        subprocess.run(["tmux", "send-keys", "-t", target, "-l", f"/model {pm_provider}/{pm_model}"],
                       check=False, timeout=10)
        subprocess.run(["tmux", "send-keys", "-t", target, "Enter"],
                       check=False, timeout=10)
        time.sleep(3)
    subprocess.run(["tmux", "send-keys", "-t", target, "-l", prompt],
                   check=False, timeout=10)
    subprocess.run(["tmux", "send-keys", "-t", target, "Enter"],
                   check=False, timeout=10)
    print(f"已在 tmux window [{win}] 启动任务会话, prompt 已注入"
          + (f", 模型已切换 {pm_provider}/{pm_model}"
             + (f" (推理级别 {pm.get('reasoningEffort')})" if pm.get("reasoningEffort") else "")
             if pm else ""))
    print("QuickTUI 可直接 attach 查看。")
    if stable:
        print(f"会话 id 稳定: {session_id} (恢复: dsh --profile tui --resume={session_id})")
    else:
        print("恢复: TUI 内 /resume 按标题选会话, 或按退出提示的 id 用 --resume=<id>")
    return 0


def cmd_move(args) -> int:
    if len(args) != 2:
        raise KanbanError("kanban move 需要: <task-id> <state>")
    task_id, state = args
    if state not in STATES:
        raise KanbanError(f"目标状态必须是 {'/'.join(STATES)}")
    root = board_root()
    cur, entry = find_card(root, task_id)
    if cur == state:
        print(f"{task_id} 已在 {state}")
        return 0
    allowed = {
        "backlog": ("todo", "archived", "trash"),
        "todo": ("working", "archived", "trash"),
        "working": ("done", "archived", "trash"),
        "done": ("archived", "trash"),
        "archived": ("trash",),
        "trash": (),
    }
    if state not in allowed[cur]:
        raise KanbanError(f"非法迁移: {cur} -> {state} (允许: {'/'.join(allowed[cur]) or '无'})")
    if state == "done":
        text = read_card(entry)
        if not re.search(r"^- 结果:\s*completed\s*$", text, re.M):
            raise KanbanError("进 done 前须填 `结果: completed`")
        summary = section_body(text, "完成总结")
        summary_ok = bool(summary) and not has_placeholder(summary)
        report_ok = is_large(entry) and (entry / "report.md").exists() \
            and read_any_text(entry / "report.md").strip()
        if not summary_ok and not report_ok:
            raise KanbanError("进 done 前须填「完成总结」或大任务的非空 report.md")
        text = re.sub(r"^- 完成时间:.*$", f"- 完成时间: {now()}", text, count=1, flags=re.M)
        write_entry(entry, text)
    if state == "trash":
        print("提示: trash 仅限用户明确要求删除; 确认后执行。")
    os.rename(entry, root / state / entry.name)
    print(f"{task_id}: {cur} -> {state}")
    return 0


def cmd_group(args) -> int:
    if not args:
        raise KanbanError("kanban group 需要 <group-id>")
    gid = args[0]
    root = board_root()
    members = []
    for state, entry in iter_entries(root):
        g, deps = group_fields(read_card(entry))
        if g == gid:
            members.append((state, entry, deps))
    if not members:
        print(f"任务组 {gid} 没有成员")
        return 0
    print(f"任务组 {gid} ({len(members)} 张卡):")
    all_done = True
    for state, entry, deps in sorted(members, key=lambda m: m[1].name):
        ready = bool(deps) and all(
            find_card_any(root, d)[0] == "done" for d in deps
        )
        if not deps:
            ready = True
        if state != "done":
            all_done = False
        dep_str = "N/A" if not deps else ", ".join(deps)
        ready_str = "就绪" if ready and state == "todo" else ""
        print(f"  {state:9s} {entry_id(entry)}  前置: {dep_str}  {ready_str}")
    print("整组完成: " + ("是" if all_done else "否"))
    return 0


def cmd_web(args) -> int:
    """kanban web [--port <n>] [--bind <ip>] — 看板状态服务:
    状态列 / 归档切换 / 关键词搜索 / 点卡看全文 / SSE 实时刷新."""
    port, bind = 8090, "0.0.0.0"
    i = 0
    while i < len(args):
        if args[i] == "--port":
            i += 1
            port = int(args[i])
        elif args[i] == "--bind":
            i += 1
            bind = args[i]
        else:
            raise KanbanError(f"未知选项: {args[i]}")
        i += 1

    def board_json():
        root = board_root()
        states = {}
        for state in STATES:
            rows = []
            state_dir = root / state
            if state_dir.is_dir():
                for entry in sorted(state_dir.iterdir()):
                    if entry.is_file() and entry.suffix == ".md":
                        large = False
                        target = entry
                    elif entry.is_dir() and (entry / "spec.md").is_file():
                        large = True
                        target = entry / "spec.md"
                    else:
                        continue
                    text = read_any_text(target)
                    gid, deps = group_fields(text)
                    m = re.search(r"^- 类型:\s*(.+)$", text, re.M)
                    t = m.group(1).strip() if m else ""
                    m = re.search(r"^- 完成时间:\s*(.+)$", text, re.M)
                    if not m:
                        m = re.search(r"^- 开始时间:\s*(.+)$", text, re.M)
                    ts = m.group(1).strip() if m else ""
                    m = re.search(r"^- 审核:\s*(.+)$", text, re.M)
                    review = m.group(1).strip() if m else ""
                    m = re.search(r"^会话:\s*(\S+)", section_body(text, "讨论与决策"), re.M)
                    sess = m.group(1) if m else ""
                    rows.append({
                        "id": entry_id(entry), "title": card_title(text),
                        "type": t, "time": ts, "large": large,
                        "group": gid, "deps": deps, "session": sess, "review": review,
                    })
            states[state] = rows
        return {"board": root.as_posix(), "states": states}

    def task_json(tid: str):
        root = board_root()
        _, entry = find_card(root, tid)
        text = read_any_text(spec_path(entry))
        return {"id": tid, "title": card_title(text), "text": text}

    board_page = """<!doctype html><html lang="zh"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>看板 · __BOARD_PATH__</title>
<style>
body{background:#121212;color:#e8e8e8;font:14px/1.5 system-ui;margin:0;padding:16px}
h1{font-size:18px;margin:0 0 4px} .bar{display:flex;gap:10px;align-items:center;margin:8px 0 14px;flex-wrap:wrap}
input#kw{background:#1c1c1c;border:1px solid #333;color:#e8e8e8;border-radius:6px;padding:6px 10px;flex:1;min-width:160px}
button{background:#1c1c1c;border:1px solid #444;color:#e8e8e8;border-radius:6px;padding:6px 12px;cursor:pointer}
button.on{border-color:#7ee787;color:#7ee787} #status{color:#666;font-size:12px}
.cols{display:flex;gap:12px;flex-wrap:wrap}
.col{flex:1 1 250px;background:#1c1c1c;border-radius:10px;padding:12px}
h2{font-size:14px;margin:0 0 8px;font-weight:600} h2 .n{color:#888;font-weight:400}
